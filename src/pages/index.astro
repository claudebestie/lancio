---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import Problem from '../components/Problem.astro';
import Exemples from '../components/Exemples.astro';
import Pricing from '../components/Pricing.astro';
import AuditCTA from '../components/AuditCTA.astro';
import Process from '../components/Process.astro';
import Differentiation from '../components/Differentiation.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Sites web qui convertissent · freelances, coachs, consultants | Lancio"
  description="3 offres claires pour attirer de meilleurs clients : audit 150€ (48h), refonte page 700€ (7j), site complet 1200€ (14j). Copy orientée conversion. Satisfait ou remboursé."
  canonical="https://lancio.fr/"
>
  <Nav />
  <main>
    <Hero />
    <SocialProof />
    <Problem />
    <Exemples />
    <Pricing />
    <AuditCTA />
    <Process />
    <Differentiation />
    <FAQ />
    <LeadForm />
    <FinalCTA />
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding-top: 0;
  }
</style>
