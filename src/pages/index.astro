---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Secteurs from '../components/Secteurs.astro';
import Problem from '../components/Problem.astro';
import Exemples from '../components/Exemples.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import Temoignages from '../components/Temoignages.astro';
import QuiSommesNous from '../components/QuiSommesNous.astro';
import FAQ from '../components/FAQ.astro';
import Commander from '../components/Commander.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Site internet professionnel en 48h | 490 € tout compris | Lancio"
  description="Votre site internet pro livré en 48h à partir de 490 €. Design sur mesure pour restaurant, coiffeur, avocat, médecin, artisan. Brief en 5 min, sans engagement."
  canonical="https://lancio.fr/"
>
  <Nav />
  <main>
    <Hero />
    <Secteurs />
    <Problem />
    <Exemples />
    <Process />
    <Pricing />
    <Temoignages />
    <QuiSommesNous />
    <FAQ />
    <Commander />
  </main>
  <Footer />
</Layout>

<style>
  main {
    padding-top: 0;
  }
</style>
