---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">Lancio<span class="footer-dot">.</span></a>
        <p class="footer-tagline">Site livré rapidement, pensé pour convertir.</p>
      </div>
      <nav class="footer-links">
        <a href="#comment">Comment ça marche</a>
        <a href="#exemples">Exemples</a>
        <a href="#pricing">Offre</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
        <a href="#commander">Créer mon site</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; {new Date().getFullYear()} Lancio. Tous droits réservés.</span>
      <a href="mailto:hello@lancio.fr" class="footer-email">hello@lancio.fr</a>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--black);
  padding: 48px 0 32px;
  color: rgba(255,255,255,0.5);
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 2rem;
  padding-bottom: 32px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  margin-bottom: 24px;
}

.footer-logo {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.3rem;
  color: #fff;
  letter-spacing: -0.03em;
}
.footer-dot { color: var(--accent); }

.footer-tagline {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.4);
  margin-top: 8px;
  line-height: 1.5;
  max-width: 240px;
}

.footer-links {
  display: flex;
  gap: 1.75rem;
  flex-wrap: wrap;
}
.footer-links a {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.5);
  transition: color 0.2s;
  font-weight: 500;
}
.footer-links a:hover { color: var(--accent); }

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}

.footer-copy {
  font-size: 0.78rem;
}

.footer-email {
  font-size: 0.82rem;
  color: var(--accent);
  font-weight: 500;
}
.footer-email:hover { color: var(--accent-light); }

@media (max-width: 768px) {
  .footer-top {
    flex-direction: column;
    gap: 1.5rem;
  }
  .footer-links {
    gap: 1rem 1.5rem;
  }
  .footer-bottom {
    flex-direction: column;
    text-align: center;
    gap: 0.5rem;
  }
}
</style>
