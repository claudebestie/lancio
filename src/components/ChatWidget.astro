---
// Chat Widget — live chat bulle flottante
---

<div id="chat-widget">
  <!-- Bubble -->
  <button id="chat-bubble" onclick="toggleChat()" aria-label="Chat">
    <svg id="chat-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <svg id="chat-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span id="chat-unread" style="display:none"></span>
  </button>

  <!-- Chat window -->
  <div id="chat-window" style="display:none">
    <div id="chat-header">
      <div id="chat-header-info">
        <div id="chat-header-title">Lancio</div>
        <div id="chat-header-sub">Répond en général en quelques minutes</div>
      </div>
      <button onclick="toggleChat()" id="chat-close-btn">✕</button>
    </div>

    <!-- Intro form -->
    <div id="chat-intro">
      <div id="chat-intro-inner">
        <div id="chat-intro-emoji">👋</div>
        <div id="chat-intro-title">Bonjour !</div>
        <div id="chat-intro-sub">Une question sur nos offres ? Écrivez-nous, on répond vite.</div>
        <input type="text" id="chat-name" placeholder="Votre prénom" required />
        <input type="email" id="chat-email" placeholder="Email (optionnel)" />
        <button id="chat-start-btn" onclick="startChat()">Démarrer le chat →</button>
      </div>
    </div>

    <!-- Messages area -->
    <div id="chat-messages" style="display:none">
      <div id="chat-messages-list"></div>
      <div id="chat-input-area">
        <input type="text" id="chat-input" placeholder="Votre message..." onkeydown="if(event.key==='Enter')sendMessage()" />
        <button onclick="sendMessage()" id="chat-send-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #chat-widget { position: fixed; bottom: 24px; right: 24px; z-index: 9999; font-family: var(--font-body, 'DM Sans', system-ui, sans-serif); }

  #chat-bubble {
    width: 56px; height: 56px; border-radius: 50%; border: none; cursor: pointer;
    background: var(--accent, #1A3C34); color: white;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  #chat-bubble:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(0,0,0,0.25); }

  #chat-unread {
    position: absolute; top: -4px; right: -4px;
    width: 20px; height: 20px; border-radius: 50%;
    background: #FF4444; color: white; font-size: 11px; font-weight: 600;
    display: flex; align-items: center; justify-content: center;
  }

  #chat-window {
    position: absolute; bottom: 72px; right: 0;
    width: 360px; max-height: 520px; border-radius: 16px;
    background: white; border: 1px solid rgba(0,0,0,0.1);
    box-shadow: 0 12px 48px rgba(0,0,0,0.15);
    display: flex; flex-direction: column; overflow: hidden;
  }

  #chat-header {
    background: var(--accent, #1A3C34); color: white;
    padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;
  }
  #chat-header-title { font-size: 15px; font-weight: 600; }
  #chat-header-sub { font-size: 11px; opacity: 0.7; margin-top: 2px; }
  #chat-close-btn { background: none; border: none; color: white; font-size: 18px; cursor: pointer; opacity: 0.7; }
  #chat-close-btn:hover { opacity: 1; }

  #chat-intro { padding: 32px 24px; text-align: center; }
  #chat-intro-emoji { font-size: 36px; margin-bottom: 8px; }
  #chat-intro-title { font-size: 20px; font-weight: 600; margin-bottom: 6px; color: #0E0E0E; }
  #chat-intro-sub { font-size: 13px; color: #5A5A55; margin-bottom: 20px; line-height: 1.5; }
  #chat-intro input {
    width: 100%; padding: 10px 14px; border: 1px solid rgba(0,0,0,0.12);
    border-radius: 8px; font-size: 14px; font-family: inherit; margin-bottom: 10px; outline: none;
  }
  #chat-intro input:focus { border-color: var(--accent, #1A3C34); }
  #chat-start-btn {
    width: 100%; padding: 12px; border: none; border-radius: 8px;
    background: var(--accent, #1A3C34); color: white;
    font-size: 14px; font-weight: 500; cursor: pointer; font-family: inherit;
    transition: background 0.15s;
  }
  #chat-start-btn:hover { background: var(--accent-light, #2A5C52); }

  #chat-messages { display: flex; flex-direction: column; height: 380px; }
  #chat-messages-list {
    flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 8px;
  }

  .chat-msg {
    max-width: 80%; padding: 10px 14px; border-radius: 14px;
    font-size: 13px; line-height: 1.5; word-break: break-word;
  }
  .chat-msg.visitor {
    align-self: flex-end; background: var(--accent, #1A3C34); color: white;
    border-bottom-right-radius: 4px;
  }
  .chat-msg.admin {
    align-self: flex-start; background: #F0F0EC; color: #0E0E0E;
    border-bottom-left-radius: 4px;
  }
  .chat-msg-time { font-size: 10px; opacity: 0.5; margin-top: 4px; }

  #chat-input-area {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 16px; border-top: 1px solid rgba(0,0,0,0.08);
  }
  #chat-input {
    flex: 1; padding: 10px 14px; border: 1px solid rgba(0,0,0,0.12);
    border-radius: 8px; font-size: 13px; font-family: inherit; outline: none;
  }
  #chat-input:focus { border-color: var(--accent, #1A3C34); }
  #chat-send-btn {
    width: 36px; height: 36px; border-radius: 50%; border: none;
    background: var(--accent, #1A3C34); color: white; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s; flex-shrink: 0;
  }
  #chat-send-btn:hover { background: var(--accent-light, #2A5C52); }

  @media (max-width: 480px) {
    #chat-window { width: calc(100vw - 32px); right: -8px; bottom: 68px; max-height: 70vh; }
  }
</style>

<script is:inline>
(function() {
  const SB = 'https://rofkgmwjggvxlgrdnsyt.supabase.co';
  const KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJvZmtnbXdqZ2d2eGxncmRuc3l0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE5MzA2MTgsImV4cCI6MjA4NzUwNjYxOH0.6nlnX-0wUlID-630j5fOyveEAG0Lrp2gWhgGMRKpmNk';
  const H = { 'apikey': KEY, 'Authorization': 'Bearer ' + KEY, 'Content-Type': 'application/json', 'Prefer': 'return=representation' };

  let conversationId = localStorage.getItem('chat_conversation_id');
  let visitorName = localStorage.getItem('chat_visitor_name');
  let chatOpen = false;
  let realtimeWs = null;

  window.toggleChat = function() {
    chatOpen = !chatOpen;
    document.getElementById('chat-window').style.display = chatOpen ? 'flex' : 'none';
    document.getElementById('chat-icon-open').style.display = chatOpen ? 'none' : 'block';
    document.getElementById('chat-icon-close').style.display = chatOpen ? 'block' : 'none';
    document.getElementById('chat-unread').style.display = 'none';

    if (chatOpen && conversationId) {
      document.getElementById('chat-intro').style.display = 'none';
      document.getElementById('chat-messages').style.display = 'flex';
      loadMessages();
      scrollToBottom();
    }
  };

  window.startChat = async function() {
    const name = document.getElementById('chat-name').value.trim();
    const email = document.getElementById('chat-email').value.trim();
    if (!name) { document.getElementById('chat-name').focus(); return; }

    document.getElementById('chat-start-btn').textContent = '...';
    document.getElementById('chat-start-btn').disabled = true;

    try {
      const res = await fetch(SB + '/rest/v1/chat_conversations', {
        method: 'POST', headers: H,
        body: JSON.stringify({ visitor_name: name, visitor_email: email || null, page_url: location.pathname })
      });
      const data = await res.json();
      conversationId = data[0].id;
      visitorName = name;
      localStorage.setItem('chat_conversation_id', conversationId);
      localStorage.setItem('chat_visitor_name', name);

      document.getElementById('chat-intro').style.display = 'none';
      document.getElementById('chat-messages').style.display = 'flex';
      connectRealtime();

      // Send auto welcome
      addMessageToUI('admin', 'Bonjour ' + name + ' ! Comment puis-je vous aider ?');
    } catch(e) {
      console.error('Chat error:', e);
      document.getElementById('chat-start-btn').textContent = 'Erreur — réessayez';
      document.getElementById('chat-start-btn').disabled = false;
    }
  };

  window.sendMessage = async function() {
    const input = document.getElementById('chat-input');
    const text = input.value.trim();
    if (!text || !conversationId) return;

    input.value = '';
    addMessageToUI('visitor', text);
    scrollToBottom();

    try {
      await fetch(SB + '/rest/v1/chat_messages', {
        method: 'POST', headers: H,
        body: JSON.stringify({ conversation_id: conversationId, sender: 'visitor', content: text })
      });
      // Update conversation timestamp
      await fetch(SB + '/rest/v1/chat_conversations?id=eq.' + conversationId, {
        method: 'PATCH', headers: H,
        body: JSON.stringify({ updated_at: new Date().toISOString(), seen: false })
      });
    } catch(e) { console.error('Send error:', e); }
  };

  async function loadMessages() {
    if (!conversationId) return;
    try {
      const res = await fetch(SB + '/rest/v1/chat_messages?conversation_id=eq.' + conversationId + '&order=created_at.asc', { headers: H });
      const msgs = await res.json();
      const list = document.getElementById('chat-messages-list');
      list.innerHTML = '';
      if (msgs.length === 0) {
        addMessageToUI('admin', 'Bonjour ' + (visitorName || '') + ' ! Comment puis-je vous aider ?');
      } else {
        msgs.forEach(m => addMessageToUI(m.sender, m.content, m.created_at));
      }
      scrollToBottom();
      connectRealtime();
    } catch(e) { console.error('Load error:', e); }
  }

  function addMessageToUI(sender, content, timestamp) {
    const list = document.getElementById('chat-messages-list');
    const div = document.createElement('div');
    div.className = 'chat-msg ' + sender;
    const time = timestamp ? new Date(timestamp).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '';
    div.innerHTML = content + (time ? '<div class="chat-msg-time">' + time + '</div>' : '');
    list.appendChild(div);
  }

  function scrollToBottom() {
    const list = document.getElementById('chat-messages-list');
    if (list) setTimeout(() => list.scrollTop = list.scrollHeight, 50);
  }

  function connectRealtime() {
    if (realtimeWs || !conversationId) return;

    // Poll for new admin messages every 5 seconds (simpler than WebSocket for static site)
    let lastCount = 0;
    realtimeWs = setInterval(async () => {
      try {
        const res = await fetch(SB + '/rest/v1/chat_messages?conversation_id=eq.' + conversationId + '&sender=eq.admin&order=created_at.asc&select=id,content,created_at', { headers: H });
        const msgs = await res.json();
        if (msgs.length > lastCount) {
          // New admin messages
          const newMsgs = msgs.slice(lastCount);
          newMsgs.forEach(m => addMessageToUI('admin', m.content, m.created_at));
          scrollToBottom();
          lastCount = msgs.length;

          if (!chatOpen) {
            const badge = document.getElementById('chat-unread');
            badge.textContent = newMsgs.length;
            badge.style.display = 'flex';
          }
        }
      } catch(e) {}
    }, 5000);
  }

  // Restore session on load
  if (conversationId) {
    connectRealtime();
  }
})();
</script>
