---
---
<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Pour coachs, consultants, thérapeutes, indépendants...
      </div>
      <h1 class="hero-h1">
        Crée un site qui te génère<br/>
        <span class="hero-accent">des clients en 48h</span>
      </h1>
      <p class="hero-sub">
        On conçoit ton site de coaching, consulting ou thérapie — prêt à convertir, sans agence, sans complexité.
      </p>
      <ul class="hero-trust">
        <li>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="var(--accent-pale)"/><path d="M5.5 9l2.5 2.5 4.5-4.5" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Livraison en 48h
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="var(--accent-pale)"/><path d="M5.5 9l2.5 2.5 4.5-4.5" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Design + copy optimisés conversion
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="var(--accent-pale)"/><path d="M5.5 9l2.5 2.5 4.5-4.5" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Satisfait ou remboursé
        </li>
      </ul>
      <div class="hero-actions">
        <a href="#commander" class="btn-primary">Créer mon site maintenant</a>
        <a href="#exemples" class="btn-secondary">Voir des exemples</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-mockup">
        <div class="mockup-bar">
          <div class="mockup-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="mockup-url">votre-site.fr</span>
        </div>
        <div class="mockup-screen">
          <img src="/secteurs/restaurant3.jpg" alt="Exemple de site professionnel livré par Lancio" loading="eager" width="600" height="375" />
        </div>
      </div>
      <div class="hero-float hero-float-1">
        <span class="float-icon float-icon-green">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <div class="float-title">Site livré</div>
          <div class="float-sub">il y a 2h — Restaurant, Lyon</div>
        </div>
      </div>
      <div class="hero-float hero-float-2">
        <span class="float-icon float-icon-accent">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <div>
          <div class="float-title">+12 demandes</div>
          <div class="float-sub">cette semaine via le site</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  padding: 5rem 24px 4rem;
  max-width: var(--max-w);
  margin: 0 auto;
  overflow: visible;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--accent-pale);
  border: 1px solid rgba(232,98,44,0.2);
  color: var(--accent-dark);
  font-size: 0.82rem;
  font-weight: 600;
  padding: 0.4rem 1rem;
  border-radius: 999px;
  margin-bottom: 1.5rem;
}
.badge-dot {
  width: 8px;
  height: 8px;
  background: var(--accent);
  border-radius: 50%;
  display: inline-block;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.hero-h1 {
  font-size: clamp(2.4rem, 4.5vw, 3.6rem);
  font-weight: 800;
  line-height: 1.08;
  color: var(--text-primary);
  margin-bottom: 1.25rem;
  letter-spacing: -0.035em;
}
.hero-accent { color: var(--accent); }

.hero-sub {
  font-size: 1.1rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 1.75rem;
  max-width: 440px;
}

.hero-trust {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-bottom: 2rem;
}
.hero-trust li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.95rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  background: var(--accent);
  color: #fff;
  padding: 0.9rem 2rem;
  border-radius: 10px;
  font-weight: 700;
  font-size: 1rem;
  transition: all 0.25s cubic-bezier(.16,1,.3,1);
  box-shadow: 0 4px 16px rgba(232,98,44,0.25);
  letter-spacing: -0.01em;
}
.btn-primary:hover {
  background: var(--accent-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(232,98,44,0.3);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  color: var(--text-secondary);
  font-size: 0.95rem;
  font-weight: 600;
  padding: 0.9rem 1.5rem;
  border: 1px solid var(--border-strong);
  border-radius: 10px;
  transition: all 0.2s;
}
.btn-secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-pale);
}

/* Visual / Mockup */
.hero-visual {
  position: relative;
}

.hero-mockup {
  background: var(--black);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(26,26,46,0.18), 0 8px 24px rgba(26,26,46,0.08);
}

.mockup-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: #232340;
}

.mockup-dots { display: flex; gap: 6px; }
.dot { width: 10px; height: 10px; border-radius: 50%; }
.dot-red { background: #ff5f57; }
.dot-yellow { background: #ffbd2e; }
.dot-green { background: #28c840; }

.mockup-url {
  margin-left: 12px;
  font-size: 12px;
  color: rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.08);
  padding: 3px 14px;
  border-radius: 6px;
}

.mockup-screen {
  aspect-ratio: 16/10;
  overflow: hidden;
}
.mockup-screen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Floating cards */
.hero-float {
  position: absolute;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.hero-float-1 {
  bottom: -16px;
  left: -20px;
  animation: float-in 0.7s 0.4s both cubic-bezier(.16,1,.3,1);
}
.hero-float-2 {
  top: 24px;
  right: -16px;
  animation: float-in 0.7s 0.7s both cubic-bezier(.16,1,.3,1);
}

@keyframes float-in {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}

.float-icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.float-icon-green { background: #22c55e; }
.float-icon-accent { background: var(--accent); }

.float-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
}
.float-sub {
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.3;
}

@media (max-width: 900px) {
  .hero-inner {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .hero { padding: 3.5rem 20px 2.5rem; }
  .hero-visual { max-width: 520px; }
  .hero-float-2 { right: 0; }
}

@media (max-width: 640px) {
  .hero { padding: 2.5rem 20px 2rem; }
  .hero-actions {
    flex-direction: column;
    width: 100%;
  }
  .btn-primary, .btn-secondary {
    width: 100%;
    justify-content: center;
    text-align: center;
  }
  .hero-float-1 { left: 0; }
}
</style>
