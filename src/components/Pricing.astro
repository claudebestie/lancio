---
const STRIPE_AUDIT = "https://buy.stripe.com/eVqeVd6Vjdsz64c7Mj4Ja0h";
const STRIPE_REFONTE = "https://buy.stripe.com/00w8wP4Nb2NVdwEfeL4Ja0k";
const STRIPE_SITE = "https://buy.stripe.com/cNi9ATbbzgELfEM1nV4Ja0l";
const CAL_LINK = "https://cal.eu/lancio/discovery-call-15-min";

const services = [
  {
    name: "Audit",
    desc: "Pour valider où tu coinces avant d'investir plus.",
    price: "150",
    unit: "€",
    badge: null,
    features: [
      "Analyse complète site + cible",
      "5-7 reco actionnables",
      "Loom commenté + doc Notion",
      "Livré sous 48h",
      "150€ déduits si refonte/site dans 30j",
    ],
    cta: "Réserver l'audit",
    href: STRIPE_AUDIT,
    highlight: false,
  },
  {
    name: "Refonte page",
    desc: "Ta page principale refaite. Copy + design.",
    price: "700",
    unit: "€",
    badge: "Le plus choisi",
    features: [
      "Audit inclus",
      "Copy orientée conversion",
      "Design premium sur mesure",
      "Mobile + desktop",
      "Livré sous 7 jours",
      "Suivi 30 jours inclus",
    ],
    cta: "Réserver un appel",
    href: CAL_LINK,
    highlight: true,
  },
  {
    name: "Site complet",
    desc: "Site 5 pages sur mesure + intégrations.",
    price: "1200",
    unit: "€",
    badge: null,
    features: [
      "Audit inclus",
      "5 pages sur mesure",
      "Cal.com + Stripe intégrés",
      "SEO technique de base",
      "Livré sous 14 jours",
      "Suivi 30 jours inclus",
    ],
    cta: "Réserver un appel",
    href: CAL_LINK,
    highlight: false,
  },
];

const abonnements = [
  {
    name: "Présence",
    desc: "On maintient ton site pour toi",
    price: "15",
    features: [
      "Hébergement + maintenance",
      "1 modification/mois",
      "SSL + domaine inclus",
      "Support par email",
    ],
    highlight: false,
  },
  {
    name: "Visibilité",
    desc: "On te rend visible sur Google",
    price: "39",
    badge: "Populaire",
    features: [
      "Tout Présence +",
      "2 articles blog SEO/mois",
      "Google My Business",
      "Rapport trafic mensuel",
    ],
    highlight: true,
  },
  {
    name: "Croissance",
    desc: "Un système complet pour tes clients",
    price: "89",
    features: [
      "Tout Visibilité +",
      "Landing page capture email",
      "Séquence email automatique",
      "1 page de vente/mois",
      "Audit conversion mensuel",
    ],
    highlight: false,
  },
];
---

<section class="pricing section-pad" id="pricing">
  <div class="container">

    <!-- ═══ PARTIE 1 : SERVICES (3 tiers) ═══ -->
    <div class="section-header">
      <div class="section-tag">Par où commencer ?</div>
      <h2 class="section-h2">3 façons de travailler<br/><em>ensemble.</em></h2>
      <p class="section-sub">Choisis selon où tu en es. Tarifs transparents, paiement unique, 100% propriétaire de ton site.</p>
    </div>

    <div class="services-grid">
      {services.map(s => (
        <div class={`service-card ${s.highlight ? 'service-highlight' : ''}`}>
          {s.badge && <div class="service-badge">{s.badge}</div>}
          <div class="service-name">{s.name}</div>
          <div class="service-desc">{s.desc}</div>
          <div class="service-price">
            <span class="service-amount">{s.price}</span>
            <span class="service-unit">{s.unit}</span>
          </div>
          <div class="service-features">
            {s.features.map(f => (
              <div class="service-feature">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="7" fill="var(--accent-pale)"/><path d="M4 7l2 2 4-4" stroke="var(--accent)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{f}</span>
              </div>
            ))}
          </div>
          <a href={s.href} class={`service-cta ${s.highlight ? 'service-cta-primary' : 'service-cta-secondary'}`} target="_blank" rel="noopener">
            {s.cta}
          </a>
        </div>
      ))}
    </div>

    <!-- ═══ PARTIE 2 : ABONNEMENTS ═══ -->
    <div class="section-header abo-header">
      <div class="section-tag">Maintenance · optionnel</div>
      <h2 class="section-h2">Fais grandir<br/><em>ton activité.</em></h2>
      <p class="section-sub"><strong>À souscrire après la livraison de ton site.</strong> Pour que ton site continue à travailler pour toi, chaque mois.</p>
    </div>

    <div class="abo-grid">
      {abonnements.map(abo => (
        <div class={`abo-card ${abo.highlight ? 'abo-highlight' : ''}`}>
          {abo.badge && <div class="abo-badge">{abo.badge}</div>}
          <div class="abo-name">{abo.name}</div>
          <div class="abo-desc">{abo.desc}</div>
          <div class="abo-price">
            <span class="abo-amount">{abo.price}</span>
            <span class="abo-unit">€<small>/mois</small></span>
          </div>
          <div class="abo-features">
            {abo.features.map(f => (
              <div class="abo-feature">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="7" fill="var(--accent-pale)"/><path d="M4 7l2 2 4-4" stroke="var(--accent)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{f}</span>
              </div>
            ))}
          </div>
          <a href="/contact" class={`abo-cta ${abo.highlight ? 'abo-cta-primary' : 'abo-cta-secondary'}`}>
            Choisir {abo.name}
          </a>
        </div>
      ))}
    </div>

    <div class="pricing-note-wrap">
      <p class="pricing-note">Les abonnements sont disponibles après la livraison de ton site. Sans engagement, résiliable à tout moment.</p>
    </div>

  </div>
</section>

<style>
/* ═══ SERVICES 3-TIER (NEW) ═══ */
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
  margin-bottom: 80px;
}
.service-card {
  background: var(--white);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-xl);
  padding: 36px 28px;
  display: flex;
  flex-direction: column;
  position: relative;
}
.service-highlight {
  background: var(--text-primary);
  color: var(--white);
  border-color: var(--text-primary);
  transform: scale(1.04);
  box-shadow: 0 16px 48px rgba(26,26,46,0.18);
}
.service-highlight .service-name,
.service-highlight .service-desc,
.service-highlight .service-amount,
.service-highlight .service-unit,
.service-highlight .service-feature span { color: var(--white); }
.service-highlight .service-desc { opacity: 0.85; }

.service-badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 999px;
}
.service-name {
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 12px;
}
.service-desc {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 20px;
  min-height: 42px;
}
.service-price {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 24px;
}
.service-amount {
  font-family: var(--font-display);
  font-size: 48px;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1;
  color: var(--text-primary);
}
.service-unit {
  font-size: 20px;
  font-weight: 600;
  color: var(--text-primary);
}
.service-features {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 28px;
  flex-grow: 1;
}
.service-feature {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
}
.service-feature svg { flex-shrink: 0; margin-top: 3px; }
.service-highlight .service-feature svg circle { fill: rgba(232,98,44,0.25); }

.service-cta {
  display: block;
  text-align: center;
  padding: 14px 20px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 15px;
  transition: transform 0.15s ease;
}
.service-cta:hover { transform: translateY(-1px); }
.service-cta-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 4px 16px rgba(232,98,44,0.3);
}
.service-cta-secondary {
  background: var(--cream);
  color: var(--text-primary);
  border: 1px solid var(--border-strong);
}

@media (max-width: 900px) {
  .services-grid { grid-template-columns: 1fr; gap: 16px; margin-bottom: 56px; }
  .service-highlight { transform: none; }
  .service-desc { min-height: auto; }
}

/* ═══ LEGACY (site-block, now unused but kept for safety) ═══ */
.section-header { text-align: center; }
.section-tag {
  display: inline-block; font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
}
.section-h2 { font-size: clamp(28px, 4vw, 44px); color: var(--text-primary); margin-bottom: 16px; line-height: 1.1; }
.section-h2 em { font-style: italic; color: var(--accent); }
.section-sub { font-size: 15px; color: var(--text-secondary); max-width: 420px; margin: 0 auto; line-height: 1.7; }

/* ═══ SITE BLOCK ═══ */
.site-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 80px;
}

.site-visual { position: relative; }
.site-mockup {
  background: var(--black);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(26,26,46,0.15);
}
.mockup-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 14px;
  background: #232340;
}
.dot { width: 8px; height: 8px; border-radius: 50%; }
.dot-red { background: #ff5f57; }
.dot-yellow { background: #ffbd2e; }
.dot-green { background: #28c840; }
.mockup-url {
  margin-left: 10px;
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.08);
  padding: 2px 12px;
  border-radius: 4px;
}
.mockup-screen { aspect-ratio: 16/10; overflow: hidden; }
.mockup-screen img { width: 100%; height: 100%; object-fit: cover; }

.site-float {
  position: absolute;
  bottom: -20px;
  right: -20px;
  width: 140px;
  height: 140px;
  border-radius: 16px;
  overflow: hidden;
  border: 3px solid var(--white);
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}
.float-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.site-info { display: flex; flex-direction: column; gap: 24px; }

.site-price-row {
  display: flex;
  align-items: center;
  gap: 20px;
}
.site-price { display: flex; align-items: baseline; gap: 4px; }
.site-amount {
  font-family: var(--font-display);
  font-size: 4rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
  letter-spacing: -0.03em;
}
.site-currency {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-secondary);
}
.site-delivery { display: flex; flex-direction: column; gap: 4px; }
.delivery-badge {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  background: var(--accent);
  padding: 4px 12px;
  border-radius: 100px;
  width: fit-content;
}
.delivery-note {
  font-size: 0.82rem;
  color: var(--text-muted);
}

.site-features {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.site-feature {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.site-cta {
  display: block;
  text-align: center;
  font-size: 1rem;
  font-weight: 700;
  background: var(--accent);
  color: #fff;
  padding: 16px 28px;
  border-radius: 12px;
  transition: all 0.25s cubic-bezier(.16,1,.3,1);
  box-shadow: 0 4px 16px rgba(232,98,44,0.25);
}
.site-cta:hover {
  background: var(--accent-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(232,98,44,0.3);
}
.site-note {
  font-size: 0.82rem;
  color: var(--text-muted);
  text-align: center;
  margin-top: -12px;
}

/* ═══ ABONNEMENTS ═══ */
.abo-header { margin-top: 0; }

.abo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}

.abo-card {
  background: var(--white);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: all 0.25s;
}
.abo-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(26,26,46,0.08);
}
.abo-highlight {
  border: 2px solid var(--accent);
  box-shadow: 0 8px 32px rgba(232,98,44,0.1);
}

.abo-badge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #fff;
  background: var(--accent);
  padding: 4px 14px;
  border-radius: 100px;
  white-space: nowrap;
}

.abo-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}
.abo-desc {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-bottom: 16px;
  line-height: 1.5;
}
.abo-price {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}
.abo-amount {
  font-family: var(--font-display);
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
  letter-spacing: -0.03em;
}
.abo-unit {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-secondary);
}
.abo-unit small {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-muted);
}

.abo-features {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 24px;
  flex: 1;
}
.abo-feature {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.82rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.abo-cta {
  display: block;
  text-align: center;
  font-size: 0.9rem;
  font-weight: 700;
  padding: 14px 20px;
  border-radius: 10px;
  transition: all 0.25s cubic-bezier(.16,1,.3,1);
  margin-top: auto;
}
.abo-cta-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 4px 16px rgba(232,98,44,0.2);
}
.abo-cta-primary:hover {
  background: var(--accent-light);
  transform: translateY(-2px);
}
.abo-cta-secondary {
  background: var(--white);
  color: var(--accent);
  border: 1px solid var(--accent);
}
.abo-cta-secondary:hover {
  background: var(--accent-pale);
  transform: translateY(-2px);
}

.pricing-note-wrap { text-align: center; margin-top: 24px; }
.pricing-note { font-size: 0.82rem; color: var(--text-muted); }

@media (max-width: 900px) {
  .site-block { grid-template-columns: 1fr; gap: 32px; }
  .site-visual { max-width: 480px; }
  .site-float { right: 0; }
  .site-features { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .abo-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
}
@media (max-width: 640px) {
  .site-amount { font-size: 3rem; }
  .site-price-row { flex-direction: column; align-items: flex-start; gap: 12px; }
}
</style>
