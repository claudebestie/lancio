---
const problems = [
  {
    title: "Message flou",
    desc: "Ton visiteur arrive sur ton site et ne comprend pas ce que tu fais en 5 secondes. Il part.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  },
  {
    title: "Mauvais clients",
    desc: "Tu attires des gens qui négocient, qui ne matchent pas, ou tu n'attires personne.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>`,
  },
  {
    title: "Temps perdu",
    desc: "Tu passes ton temps à expliquer ce que tu fais au lieu que ton site le fasse pour toi.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
  {
    title: "Prix tiré vers le bas",
    desc: "On te compare aux moins chers parce que ta valeur n'est pas visible sur ton site.",
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  },
];
---

<section class="problem section-pad" id="problem">
  <div class="container">
    <div class="problem-header">
      <div class="section-tag">Le vrai problème</div>
      <h2 class="section-h2">Tu as un site.<br/><em>Il ne travaille pas pour toi.</em></h2>
      <p class="problem-intro">
        Le problème, c'est pas ton offre. C'est pas ton prix.<br/>
        C'est que ton site ne dit pas clairement pourquoi on devrait te choisir.
      </p>
    </div>

    <div class="problem-grid">
      {problems.map((p, i) => (
        <div class="problem-card">
          <div class="card-top">
            <div class="card-icon" set:html={p.icon} />
            <span class="card-num">0{i + 1}</span>
          </div>
          <h3 class="card-title">{p.title}</h3>
          <p class="card-desc">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="problem-bottom">
      <div class="problem-result">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2L2 18h16L10 2z" fill="var(--accent)" opacity="0.12" stroke="var(--accent)" stroke-width="1.2" stroke-linejoin="round"/><line x1="10" y1="8" x2="10" y2="12" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"/><circle cx="10" cy="15" r="0.8" fill="var(--accent)"/></svg>
        <p>Les bons clients partent chez quelqu'un qui a <strong>un message plus clair.</strong></p>
      </div>
      <a href="/commander/" class="problem-cta">Je veux corriger ça</a>
    </div>
  </div>
</section>

<style>
.section-tag {
  display: inline-block; font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
}
.section-h2 { font-size: clamp(28px, 4vw, 44px); color: var(--text-primary); margin-bottom: 16px; line-height: 1.1; }
.section-h2 em { font-style: italic; color: var(--accent); }

.problem-header {
  text-align: center;
  max-width: 580px;
  margin: 0 auto 56px;
}

.problem-intro {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-top: 8px;
}

.problem-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 48px;
}

.problem-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  transition: all 0.3s cubic-bezier(.16,1,.3,1);
  display: flex;
  flex-direction: column;
}
.problem-card:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 24px rgba(232,98,44,0.08);
  transform: translateY(-4px);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.card-icon {
  width: 44px;
  height: 44px;
  background: var(--accent-pale);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
}

.card-num {
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 700;
  color: var(--border-strong);
  letter-spacing: -0.02em;
}

.card-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
  line-height: 1.3;
}

.card-desc {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.65;
  flex: 1;
}

.problem-bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.problem-result {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--accent-pale);
  border: 1px solid rgba(232,98,44,0.12);
  border-radius: var(--radius-md);
  padding: 14px 24px;
  max-width: 560px;
}
.problem-result p {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
}
.problem-result strong {
  color: var(--text-primary);
}

.problem-cta {
  display: inline-flex;
  align-items: center;
  background: var(--accent);
  color: #fff;
  padding: 0.85rem 2rem;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.95rem;
  transition: all 0.25s cubic-bezier(.16,1,.3,1);
  box-shadow: 0 4px 16px rgba(232,98,44,0.2);
}
.problem-cta:hover {
  background: var(--accent-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(232,98,44,0.3);
}

@media (max-width: 900px) {
  .problem-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .problem-grid { grid-template-columns: 1fr; }
  .problem-header { margin-bottom: 40px; }
  .problem-card { padding: 24px 20px; }
}
</style>
