---
// AuditCTA.astro — section secondaire : audit payant 150€
// Pour les visiteurs pas encore prêts à commander un site complet
const STRIPE_LINK = "https://buy.stripe.com/eVqeVd6Vjdsz64c7Mj4Ja0h";
const CAL_LINK = "https://cal.eu/lancio/audit-lancio-30-min";
---

<section class="audit-cta section-pad" id="audit">
  <div class="container">
    <div class="audit-card">

      <div class="audit-badge">Alternative · plus léger</div>

      <h2 class="audit-h">Pas encore prêt(e) pour un site complet ?</h2>
      <p class="audit-sub">
        Commence par un <strong>audit conversion</strong>. Je passe ton site au crible et te livre <strong>5-7 reco actionnables</strong> en Loom commenté + doc Notion. Livré sous 48h.
      </p>

      <div class="audit-bullets">
        <div class="audit-bullet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Analyse copy + UX + structure
        </div>
        <div class="audit-bullet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          5-7 reformulations prêtes à coller
        </div>
        <div class="audit-bullet">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Loom commenté · doc Notion · 48h
        </div>
      </div>

      <div class="audit-price-row">
        <div class="audit-price">
          <span class="audit-price-amount">150€</span>
          <span class="audit-price-label">paiement unique · sans engagement</span>
        </div>
      </div>

      <div class="audit-ctas">
        <a href={STRIPE_LINK} class="audit-btn-primary" target="_blank" rel="noopener">
          Réserver mon audit · 150€
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CAL_LINK} class="audit-btn-secondary" target="_blank" rel="noopener">
          Discuter avant · appel 30min
        </a>
      </div>

      <p class="audit-foot">100% remboursé si l'audit ne t'apporte rien. Promis.</p>

    </div>
  </div>
</section>

<style>
  .audit-cta {
    background: var(--white);
  }

  .audit-card {
    max-width: 720px;
    margin: 0 auto;
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 56px 48px;
    text-align: center;
  }

  .audit-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-pale);
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 24px;
  }

  .audit-h {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.025em;
  }

  .audit-sub {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 auto 32px;
  }

  .audit-bullets {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    margin-bottom: 32px;
  }

  .audit-bullet {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 500;
  }
  .audit-bullet svg { color: var(--accent); flex-shrink: 0; }

  .audit-price-row {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .audit-price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .audit-price-amount {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .audit-price-label {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .audit-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .audit-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #fff;
    padding: 14px 24px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 15px;
    box-shadow: 0 4px 16px rgba(232,98,44,0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .audit-btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(232,98,44,0.32);
  }

  .audit-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: var(--text-primary);
    padding: 14px 22px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    font-weight: 600;
    font-size: 15px;
    transition: background 0.15s ease;
  }
  .audit-btn-secondary:hover { background: var(--white); }

  .audit-foot {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 600px) {
    .audit-card { padding: 40px 24px; }
    .audit-h { font-size: 24px; }
    .audit-sub { font-size: 15px; }
    .audit-price-amount { font-size: 36px; }
    .audit-btn-primary, .audit-btn-secondary { width: 100%; justify-content: center; }
  }
</style>
