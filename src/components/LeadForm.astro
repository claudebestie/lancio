---

<section class="lead section-pad" id="lead">
  <div class="container">
    <div class="lead-layout">
      <div class="lead-text">
        <div class="section-tag">Lancer mon projet</div>
        <h2 class="section-h2">Parle-nous de<br/><em>ton projet</em></h2>
        <p class="lead-sub">Remplis ce formulaire rapide et on revient vers toi sous 24h avec une proposition claire.</p>
        <div class="lead-reassure">
          <div class="reassure-item">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="var(--accent-pale)"/><path d="M5 8l2 2 4-4" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sans engagement
          </div>
          <div class="reassure-item">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="var(--accent-pale)"/><path d="M5 8l2 2 4-4" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Réponse sous 24h
          </div>
          <div class="reassure-item">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="8" fill="var(--accent-pale)"/><path d="M5 8l2 2 4-4" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Données confidentielles
          </div>
        </div>
      </div>

      <form class="lead-form" id="leadForm">
        <div class="field-row">
          <div class="field-group">
            <label class="field-label">Nom *</label>
            <input type="text" id="lead-nom" placeholder="Marie Dupont" required />
          </div>
          <div class="field-group">
            <label class="field-label">Email *</label>
            <input type="email" id="lead-email" placeholder="marie@exemple.fr" required />
          </div>
        </div>

        <div class="field-group">
          <label class="field-label">Nom de l'activité *</label>
          <input type="text" id="lead-activite" placeholder="Ex: Studio Yoga Paris" required />
        </div>

        <div class="field-group">
          <label class="field-label">Lien de votre site actuel <span class="optional">(optionnel)</span></label>
          <input type="text" id="lead-site" placeholder="www.monsite.fr" />
        </div>

        <div class="field-group">
          <label class="field-label">Ce dont vous avez besoin *</label>
          <textarea id="lead-besoin" rows="3" placeholder="Nouveau site, refonte, landing page..." required></textarea>
        </div>

        <div id="lead-error" class="form-error" style="display:none;"></div>
        <div id="lead-success" class="form-success" style="display:none;">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#22c55e"/><path d="M6 10l3 3 5-5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Message envoyé ! On revient vers toi très vite.</span>
        </div>

        <button type="submit" class="form-submit" id="leadSubmit">Lancer mon projet</button>
      </form>
    </div>
  </div>
</section>

<script>
  const SUPABASE_URL = 'https://rofkgmwjggvxlgrdnsyt.supabase.co';
  const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJvZmtnbXdqZ2d2eGxncmRuc3l0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE5MzA2MTgsImV4cCI6MjA4NzUwNjYxOH0.6nlnX-0wUlID-630j5fOyveEAG0Lrp2gWhgGMRKpmNk';

  document.getElementById('leadForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('leadSubmit') as HTMLButtonElement;
    const errorEl = document.getElementById('lead-error');
    const successEl = document.getElementById('lead-success');

    const nom = (document.getElementById('lead-nom') as HTMLInputElement)?.value?.trim();
    const email = (document.getElementById('lead-email') as HTMLInputElement)?.value?.trim();
    const activite = (document.getElementById('lead-activite') as HTMLInputElement)?.value?.trim();
    const site = (document.getElementById('lead-site') as HTMLInputElement)?.value?.trim();
    const besoin = (document.getElementById('lead-besoin') as HTMLTextAreaElement)?.value?.trim();

    if (!nom || !email || !activite || !besoin) {
      if (errorEl) { errorEl.textContent = 'Merci de remplir tous les champs obligatoires.'; errorEl.style.display = 'block'; }
      return;
    }

    if (errorEl) errorEl.style.display = 'none';
    if (btn) { btn.disabled = true; btn.textContent = 'Envoi en cours...'; }

    try {
      const res = await fetch(SUPABASE_URL + '/rest/v1/lancio_messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY, Prefer: 'return=minimal' },
        body: JSON.stringify({ nom, email, tel: '', message: `Activité: ${activite}\nSite actuel: ${site || 'Aucun'}\nBesoin: ${besoin}`, source: 'lead_form' })
      });

      if (res.ok || res.status === 201) {
        if (successEl) successEl.style.display = 'flex';
        if (btn) btn.style.display = 'none';
        (document.getElementById('leadForm') as HTMLFormElement)?.querySelectorAll('input, textarea').forEach(el => (el as HTMLInputElement).disabled = true);
        window.datafast?.('lead_submitted', { source: 'lead_form' });
      } else {
        throw new Error('status ' + res.status);
      }
    } catch(e) {
      if (btn) { btn.disabled = false; btn.textContent = 'Lancer mon projet'; }
      if (errorEl) { errorEl.textContent = 'Erreur lors de l\'envoi. Réessayez ou contactez hello@lancio.fr'; errorEl.style.display = 'block'; }
    }
  });
</script>

<style>
.section-tag {
  display: inline-block; font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
}
.section-h2 { font-size: clamp(28px, 4vw, 44px); color: var(--text-primary); margin-bottom: 16px; line-height: 1.1; }
.section-h2 em { font-style: italic; color: var(--accent); }

.lead-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}

.lead-sub {
  font-size: 1rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 1.5rem;
}

.lead-reassure {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.reassure-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--text-secondary);
  font-weight: 500;
}

.lead-form {
  background: var(--white);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-xl);
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.field-group { display: flex; flex-direction: column; gap: 6px; }
.field-label {
  font-size: 12px; font-weight: 500; color: var(--text-secondary);
  text-transform: uppercase; letter-spacing: .05em;
}
.field-label .optional { text-transform: none; letter-spacing: 0; color: var(--text-muted); font-weight: 400; }

input, textarea {
  font-family: var(--font-body); font-size: 14px; color: var(--text-primary);
  background: var(--white); border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm); padding: 10px 14px; width: 100%;
  transition: border-color .15s; outline: none;
}
input:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(232,98,44,0.08); }
textarea { resize: vertical; min-height: 80px; }

.form-submit {
  font-family: var(--font-body); font-size: 15px; font-weight: 700;
  background: var(--accent); color: #fff; border: none;
  border-radius: var(--radius-md); padding: 16px 24px; cursor: pointer;
  transition: all 0.25s cubic-bezier(.16,1,.3,1); width: 100%; text-align: center;
  box-shadow: 0 4px 16px rgba(232,98,44,0.2);
}
.form-submit:hover { background: var(--accent-light); transform: translateY(-1px); box-shadow: 0 8px 28px rgba(232,98,44,0.3); }
.form-submit:disabled { opacity: .6; cursor: not-allowed; transform: none; }

.form-error {
  font-size: 13px; color: #A32D2D; padding: 10px;
  background: #FEF0F0; border-radius: 8px;
}

.form-success {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: #166534;
  background: #F0FDF4;
  padding: 12px 16px;
  border-radius: 8px;
  font-weight: 500;
}

@media (max-width: 900px) {
  .lead-layout { grid-template-columns: 1fr; gap: 2.5rem; }
}
@media (max-width: 480px) {
  .field-row { grid-template-columns: 1fr; }
  .lead-form { padding: 24px; }
}
</style>
