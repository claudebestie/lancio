---
const realisations = [
  {
    nom: "Trattoria Bella",
    secteur: "Restaurant",
    ville: "Bordeaux",
    image: "/secteurs/restaurant3.jpg",
    features: ["Menu digital", "Reservation", "Google Maps"],
    couleur: "#e8c97a",
    couleurBg: "#2a1505",
  },
  {
    nom: "House of Fade",
    secteur: "Barbier",
    ville: "Lyon",
    image: "/secteurs/barbershop2.jpg",
    features: ["Booking", "Galerie", "Tarifs"],
    couleur: "#c9a96e",
    couleurBg: "#1a1714",
  },
  {
    nom: "Cafe Analog",
    secteur: "Cafe",
    ville: "Paris",
    image: "/secteurs/cafe4.jpg",
    features: ["Menu", "Horaires", "Instagram"],
    couleur: "#d4a574",
    couleurBg: "#2c1810",
  },
  {
    nom: "Cabinet Mercier",
    secteur: "Avocat",
    ville: "Toulouse",
    image: "/secteurs/lawyer2.jpg",
    features: ["Expertises", "RDV en ligne", "Blog"],
    couleur: "#6b89ab",
    couleurBg: "#1a2a3a",
  },
  {
    nom: "Studio Flow",
    secteur: "Pilates",
    ville: "Marseille",
    image: "/secteurs/pilate2.jpg",
    features: ["Planning", "Packs", "Paiement"],
    couleur: "#a8d65c",
    couleurBg: "#1a2e0a",
  },
];
---

<section class="realisations section-pad" id="realisations">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Realisations</div>
      <h2 class="section-h2">Des sites livres.<br/><em>En 48h.</em></h2>
      <p class="section-sub">Chaque projet est unique. Voici ce qu'on livre — le votre sera aussi personnalise.</p>
    </div>

    <div class="real-grid">
      {realisations.map(r => (
        <div class="real-card">
          <div class="real-image">
            <img src={r.image} alt={`Site ${r.secteur} - ${r.nom}`} loading="lazy" />
            <div class="real-overlay">
              <span class="real-badge" style={`background:${r.couleur};color:${r.couleurBg};`}>{r.secteur}</span>
            </div>
          </div>
          <div class="real-body">
            <div class="real-name">{r.nom}</div>
            <div class="real-ville">{r.ville} · Livre en 48h</div>
            <div class="real-features">
              {r.features.map(f => (
                <span class="real-feat">{f}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="real-cta">
      <p class="real-cta-text">Le prochain, c'est le votre.</p>
      <a href="#mockup" class="btn-primary">Recevoir mon mockup gratuit →</a>
    </div>
  </div>
</section>

<style>
  .section-header { text-align: center; }
  .section-tag {
    display: inline-block; font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
    background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
  }
  .section-h2 {
    font-size: clamp(32px, 4vw, 48px); color: var(--text-primary);
    margin-bottom: 16px; line-height: 1.1;
  }
  .section-h2 em { font-style: italic; color: var(--accent); }
  .section-sub {
    font-size: 16px; color: var(--text-secondary);
    max-width: 480px; margin: 0 auto; line-height: 1.6;
  }

  .real-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .real-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s;
  }
  .real-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(26,26,46,0.1);
  }

  .real-image {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
  }
  .real-image img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }
  .real-card:hover .real-image img { transform: scale(1.05); }

  .real-overlay {
    position: absolute;
    top: 12px;
    left: 12px;
  }

  .real-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .real-body {
    padding: 20px;
  }

  .real-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .real-ville {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .real-features {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .real-feat {
    font-size: 10px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--cream);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .real-cta {
    text-align: center;
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .real-cta-text {
    font-size: 18px;
    color: var(--text-secondary);
    font-weight: 400;
  }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 15px; font-weight: 600; background: var(--accent);
    color: #fff; padding: 14px 28px; border-radius: var(--radius-md);
    transition: background 0.15s, transform 0.1s; text-decoration: none;
    box-shadow: 0 4px 16px rgba(232,98,44,0.2);
  }
  .btn-primary:hover { background: var(--accent-light); transform: translateY(-2px); }

  @media (max-width: 900px) {
    .real-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .real-grid { grid-template-columns: 1fr; }
  }
</style>
