---
const temoignages = [
  {
    nom: "Marie L.",
    role: "Restauratrice",
    ville: "Bordeaux",
    texte: "J'ai reçu mon mockup en 24h. Le site était en ligne 2 jours après. Mes clients me trouvent maintenant sur Google et réservent directement. Exactement ce qu'il me fallait.",
    note: 5,
  },
  {
    nom: "Thomas D.",
    role: "Coach sportif",
    ville: "Lyon",
    texte: "Je repoussais la création de mon site depuis des mois à cause des devis à 3 000 €. Avec Lancio, c'était réglé en 48h pour 490 €. Le site est propre, rapide, et mes clients adorent.",
    note: 5,
  },
  {
    nom: "Sophie M.",
    role: "Avocate",
    ville: "Paris",
    texte: "Le mockup gratuit m'a convaincue. Le rendu était exactement l'image professionnelle que je voulais projeter. Aucune surprise sur le prix. Je recommande.",
    note: 5,
  },
  {
    nom: "Karim B.",
    role: "Barbier",
    ville: "Marseille",
    texte: "Simple, rapide, efficace. Mon ancien site me coûtait 50 €/mois sur Wix et il était moche. Maintenant j'ai un vrai site pro qui m'appartient.",
    note: 5,
  },
];
---

<section class="temoignages section-pad" id="temoignages">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Témoignages</div>
      <h2 class="section-h2">Ce que disent<br/><em>nos clients.</em></h2>
      <p class="section-sub">Des indépendants et petits commerces qui ont lancé leur site avec nous.</p>
    </div>

    <div class="temoignages-grid">
      {temoignages.map(t => (
        <div class="temoin-card">
          <div class="temoin-stars">
            {Array.from({length: t.note}).map(() => (
              <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--accent)"><path d="M8 1.3l1.8 3.7 4 .6-2.9 2.8.7 4L8 10.6 4.4 12.4l.7-4L2.2 5.6l4-.6L8 1.3z"/></svg>
            ))}
          </div>
          <p class="temoin-texte">"{t.texte}"</p>
          <div class="temoin-footer">
            <div class="temoin-avatar">{t.nom.charAt(0)}</div>
            <div class="temoin-info">
              <div class="temoin-nom">{t.nom}</div>
              <div class="temoin-role">{t.role} · {t.ville}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="temoignages-cta">
      <p class="temoignages-cta-text">Rejoignez-les. Recevez votre mockup gratuit.</p>
      <a href="#mockup" class="btn-primary">Recevoir mon mockup gratuit →</a>
    </div>
  </div>
</section>

<style>
  .section-header { text-align: center; }
  .section-tag {
    display: inline-block; font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
    background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
  }
  .section-h2 {
    font-size: clamp(32px, 4vw, 48px); color: var(--text-primary);
    margin-bottom: 16px; line-height: 1.1;
  }
  .section-h2 em { font-style: italic; color: var(--accent); }
  .section-sub {
    font-size: 16px; color: var(--text-secondary);
    max-width: 480px; margin: 0 auto; line-height: 1.6;
  }

  .temoignages-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .temoin-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s;
  }
  .temoin-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(26,26,46,0.08);
  }

  .temoin-stars {
    display: flex;
    gap: 2px;
  }

  .temoin-texte {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    font-style: italic;
  }

  .temoin-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }

  .temoin-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent-pale);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .temoin-nom {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .temoin-role {
    font-size: 12px;
    color: var(--text-muted);
  }

  .temoignages-cta {
    text-align: center;
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .temoignages-cta-text {
    font-size: 18px;
    color: var(--text-secondary);
  }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 15px; font-weight: 600; background: var(--accent);
    color: #fff; padding: 14px 28px; border-radius: var(--radius-md);
    transition: background 0.15s, transform 0.1s; text-decoration: none;
    box-shadow: 0 4px 16px rgba(232,98,44,0.2);
  }
  .btn-primary:hover { background: var(--accent-light); transform: translateY(-2px); }

  @media (max-width: 700px) {
    .temoignages-grid { grid-template-columns: 1fr; }
  }
</style>
