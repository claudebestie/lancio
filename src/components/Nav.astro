---
---
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">Lancio<span class="nav-logo-dot">.</span></a>
    <ul class="nav-links">
      <li><a href="#comment">Comment ça marche</a></li>
      <li><a href="#exemples">Exemples</a></li>
      <li><a href="#pricing">Offre</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <a href="#commander" class="nav-cta">Créer mon site</a>
    <button class="nav-burger" id="navBurger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="navMobile">
    <ul>
      <li><a href="#comment">Comment ça marche</a></li>
      <li><a href="#exemples">Exemples</a></li>
      <li><a href="#pricing">Offre</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <a href="#commander" class="nav-mobile-cta">Créer mon site</a>
  </div>
</nav>

<script>
  const burger = document.getElementById('navBurger');
  const mobile = document.getElementById('navMobile');
  burger?.addEventListener('click', () => {
    mobile?.classList.toggle('open');
    burger?.classList.toggle('active');
  });
  document.querySelectorAll('.nav-mobile a').forEach(a => {
    a.addEventListener('click', () => {
      mobile?.classList.remove('open');
      burger?.classList.remove('active');
    });
  });

  // Shadow on scroll
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('nav');
    if (window.scrollY > 10) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });
</script>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(254,253,251,0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid transparent;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.nav.scrolled {
  border-bottom-color: var(--border);
  box-shadow: 0 1px 8px rgba(26,26,46,0.04);
}

.nav-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
  height: 64px;
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-logo {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.4rem;
  color: var(--text-primary);
  letter-spacing: -0.03em;
  flex-shrink: 0;
}
.nav-logo-dot { color: var(--accent); }

.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
  margin: 0 0 0 auto;
  padding: 0;
}

.nav-links a {
  color: var(--text-secondary);
  font-size: 0.88rem;
  font-weight: 500;
  transition: color 0.2s;
  letter-spacing: -0.01em;
}
.nav-links a:hover { color: var(--text-primary); }

.nav-cta {
  background: var(--accent);
  color: #fff;
  padding: 0.5rem 1.25rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.88rem;
  white-space: nowrap;
  transition: all 0.2s;
  flex-shrink: 0;
  margin-left: 0.5rem;
}
.nav-cta:hover {
  background: var(--accent-light);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(232,98,44,0.2);
}

/* Burger */
.nav-burger {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  margin-left: auto;
  width: 24px;
  height: 18px;
  position: relative;
  flex-shrink: 0;
}
.nav-burger span {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--text-primary);
  position: absolute;
  left: 0;
  transition: all 0.3s;
  border-radius: 2px;
}
.nav-burger span:nth-child(1) { top: 0; }
.nav-burger span:nth-child(2) { top: 8px; }
.nav-burger span:nth-child(3) { top: 16px; }
.nav-burger.active span:nth-child(1) { transform: rotate(45deg); top: 8px; }
.nav-burger.active span:nth-child(2) { opacity: 0; }
.nav-burger.active span:nth-child(3) { transform: rotate(-45deg); top: 8px; }

/* Mobile menu */
.nav-mobile {
  display: none;
  flex-direction: column;
  padding: 1.5rem 24px 2rem;
  border-top: 1px solid var(--border);
  background: var(--white);
}
.nav-mobile.open { display: flex; }
.nav-mobile ul {
  list-style: none;
  margin: 0 0 1.25rem;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.nav-mobile a {
  color: var(--text-primary);
  font-size: 1rem;
  font-weight: 500;
}
.nav-mobile-cta {
  display: block;
  background: var(--accent);
  color: #fff;
  padding: 0.85rem 1.5rem;
  border-radius: 10px;
  font-weight: 700;
  text-align: center;
  font-size: 0.95rem;
}

@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav-cta { display: none; }
  .nav-burger { display: block; }
  .nav-inner { padding: 0 20px; }
}
</style>
