---
---
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">Lancio</a>
    <ul class="nav-links">
      <li><a href="#exemples">Exemples</a></li>
      <li><a href="#process">Comment ça marche</a></li>
      <li><a href="#tarifs">Tarifs</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <a href="#mockup" class="nav-cta">Mockup gratuit →</a>
    <button class="nav-burger" id="navBurger" aria-label="Menu">☰</button>
  </div>
  <div class="nav-mobile" id="navMobile">
    <ul>
      <li><a href="#exemples">Exemples</a></li>
      <li><a href="#process">Comment ça marche</a></li>
      <li><a href="#tarifs">Tarifs</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
    <a href="#mockup" class="nav-mobile-cta">Mockup gratuit →</a>
  </div>
</nav>

<script>
  const burger = document.getElementById('navBurger');
  const mobile = document.getElementById('navMobile');
  burger?.addEventListener('click', () => {
    mobile?.classList.toggle('open');
  });
  document.querySelectorAll('.nav-mobile a').forEach(a => {
    a.addEventListener('click', () => mobile?.classList.remove('open'));
  });
</script>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid #e5e7eb;
}

.nav-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 64px;
  display: flex;
  align-items: center;
  gap: 2rem;
}

.nav-logo {
  font-weight: 800;
  font-size: 1.2rem;
  color: #1a1a1a;
  text-decoration: none;
  flex-shrink: 0;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 1.75rem;
  margin: 0;
  padding: 0;
  flex: 1;
}

.nav-links a {
  color: #555;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: color 0.2s;
}
.nav-links a:hover { color: #1a1a1a; }

.nav-cta {
  background: #1a1a1a;
  color: #fff;
  padding: 0.55rem 1.25rem;
  border-radius: 6px;
  font-weight: 700;
  font-size: 0.9rem;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s;
  flex-shrink: 0;
}
.nav-cta:hover { background: #2d6a4f; }

.nav-burger {
  display: none;
  background: none;
  border: none;
  font-size: 1.4rem;
  cursor: pointer;
  color: #1a1a1a;
  margin-left: auto;
}

.nav-mobile {
  display: none;
  flex-direction: column;
  padding: 1rem 2rem 1.5rem;
  border-top: 1px solid #e5e7eb;
  background: #fff;
}

.nav-mobile.open {
  display: flex;
}

.nav-mobile ul {
  list-style: none;
  margin: 0 0 1rem;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.nav-mobile a {
  color: #1a1a1a;
  text-decoration: none;
  font-size: 1rem;
  font-weight: 500;
}

.nav-mobile-cta {
  display: inline-block;
  background: #1a1a1a;
  color: #fff;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  font-weight: 700;
  text-decoration: none;
  text-align: center;
}

@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav-cta { display: none; }
  .nav-burger { display: block; }
}
</style>
