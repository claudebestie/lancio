  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Et si je n'aime pas le résultat ?",
      "acceptedAnswer": { "@type": "Answer", "text": "On ajuste ensemble. Et si ce n'est vraiment pas la bonne direction, tu es remboursé(e)." }
    },
    {
      "@type": "Question",
      "name": "Je n'ai pas encore tous mes textes",
      "acceptedAnswer": { "@type": "Answer", "text": "Pas grave. On peut t'aider à structurer le message pour que ton site soit clair et efficace." }
    },
    {
      "@type": "Question",
      "name": "Est-ce que le site sera adapté au mobile ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, il est pensé dès le départ pour être fluide et propre sur mobile, tablette et desktop." }
    },
    {
