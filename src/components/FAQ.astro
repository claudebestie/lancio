---
const faqs = [
  {
    q: "Et si je n'aime pas le résultat ?",
    r: "On ajuste ensemble. Et si ce n'est vraiment pas la bonne direction, tu es remboursé(e).",
  },
  {
    q: "Je n'ai pas encore tous mes textes",
    r: "Pas grave. On peut t'aider à structurer le message pour que ton site soit clair et efficace.",
  },
  {
    q: "Est-ce que le site sera adapté au mobile ?",
    r: "Oui, il est pensé dès le départ pour être fluide et propre sur mobile, tablette et desktop.",
  },
  {
    q: "Est-ce que vous faites seulement le design ?",
    r: "Non. Le but n'est pas juste d'avoir un beau site, mais un site clair, rassurant et orienté conversion.",
  },
  {
    q: "C'est adapté pour les coachs de vie, sportifs, business ?",
    r: "Oui, on accompagne tous les types de coachs. Le site est pensé pour valoriser ton approche, tes résultats, et intégrer un système de prise de RDV (Calendly, Cal.com...).",
  },
  {
    q: "Vous pouvez m'aider avec le contenu et les témoignages ?",
    r: "Absolument. On structure le message, on rédige les textes et on met en forme tes témoignages pour qu'ils rassurent et convertissent.",
  },
  {
    q: "C'est pour qui ?",
    r: "Coachs sportifs, de vie, business, consultants, thérapeutes, et tout indépendant qui veut un site rapide et qui convertit.",
  },
];
---

<section class="faq section-pad" id="faq">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">FAQ</div>
      <h2 class="section-h2">Questions<br/><em>fréquentes</em></h2>
    </div>

    <div class="faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>{faq.q}</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="faq-answer">
            <p>{faq.r}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="faq-contact">
      <p>Encore une question ?</p>
      <div class="faq-contact-links">
        <a href="/contact" class="faq-rdv">Prendre RDV gratuit →</a>
        <a href="mailto:hello@lancio.fr" class="faq-email">hello@lancio.fr</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      const wasExpanded = item?.classList.contains('expanded');

      // Close all
      document.querySelectorAll('.faq-item.expanded').forEach(el => {
        el.classList.remove('expanded');
        el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });

      // Toggle clicked
      if (!wasExpanded) {
        item?.classList.add('expanded');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
.section-header { text-align: center; }
.section-tag {
  display: inline-block; font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
}
.section-h2 { font-size: clamp(28px, 4vw, 44px); color: var(--text-primary); margin-bottom: 16px; line-height: 1.1; }
.section-h2 em { font-style: italic; color: var(--accent); }

.faq-list {
  max-width: 640px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.faq-item {
  border-bottom: 1px solid var(--border);
}
.faq-item:first-child {
  border-top: 1px solid var(--border);
}

.faq-question {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 20px 0;
  background: none;
  border: none;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  text-align: left;
  line-height: 1.4;
  transition: color 0.2s;
}
.faq-question:hover { color: var(--accent); }

.faq-chevron {
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform 0.3s;
}

.faq-item.expanded .faq-chevron {
  transform: rotate(180deg);
  color: var(--accent);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}
.faq-item.expanded .faq-answer {
  max-height: 200px;
}

.faq-answer p {
  padding: 0 0 20px;
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.7;
}

.faq-contact {
  max-width: 640px;
  margin: 32px auto 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px;
  background: var(--accent-pale);
  border: 1px solid rgba(232,98,44,0.15);
  border-radius: var(--radius-md);
  flex-wrap: wrap;
}
.faq-contact p {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
}
.faq-contact-links {
  display: flex;
  gap: 16px;
  align-items: center;
}
.faq-rdv {
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  background: var(--accent);
  padding: 8px 18px;
  border-radius: 8px;
  transition: all 0.2s;
}
.faq-rdv:hover { background: var(--accent-light); transform: translateY(-1px); }
.faq-email {
  font-size: 13px;
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 3px;
}

@media (max-width: 640px) {
  .faq-question { font-size: 0.95rem; padding: 16px 0; }
  .faq-contact { flex-direction: column; text-align: center; }
  .faq-contact-links { flex-direction: column; gap: 10px; }
}
</style>

<script type="application/ld+json">
