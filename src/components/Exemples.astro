---
// Exemples.astro — Lancio
// Chaque carte a un layout UNIQUE, pas juste des couleurs différentes
---

<section class="exemples section-pad" id="exemples">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Exemples</div>
      <h2 class="section-h2">Ce qu'on fait.<br/><em>Ce que vous obtenez.</em></h2>
      <p class="section-sub">Chaque site a son identité. Voici un aperçu — le vôtre sera aussi unique que votre métier.</p>
    </div>

    <div class="ex-mosaic">

      <!-- 1. RESTAURANT — Grande carte hero, plein écran, immersive -->
      <a href="/site-web-restaurant-bordeaux/" class="ex-card ex-card--hero">
        <img src="/secteurs/restaurant3.jpg" alt="Site restaurant" loading="lazy" class="ex-card__bg" />
        <div class="ex-card__overlay" style="background:linear-gradient(to top, rgba(42,21,5,0.95) 0%, rgba(42,21,5,0.4) 50%, transparent 100%);"></div>
        <div class="ex-card__inner ex-card__inner--bottom">
          <span class="ex-tag" style="background:#e8c97a;color:#2a1505;">Restaurant</span>
          <h3 class="ex-name" style="font-family:var(--font-display),Georgia,serif; font-size:32px;">Trattoria Bella</h3>
          <p class="ex-sub">Menu interactif, réservation Calendly et galerie photo pour un restaurant italien à Bordeaux.</p>
          <div class="ex-row">
            <span class="ex-btn" style="background:#e8c97a;color:#2a1505;">Voir l'exemple →</span>
            <div class="ex-chips"><span>Menu digital</span><span>Réservation</span><span>Google Maps</span></div>
          </div>
        </div>
      </a>

      <!-- 2. BARBIER — Carte horizontale, photo à gauche, dark -->
      <a href="/site-web-coiffeur-lyon/" class="ex-card ex-card--horizontal">
        <div class="ex-card__photo-side">
          <img src="/secteurs/barbershop2.jpg" alt="Site barbier" loading="lazy" />
        </div>
        <div class="ex-card__text-side" style="background:#1a1714;">
          <span class="ex-tag" style="background:#c9a96e;color:#1a1a1a;">Barbier</span>
          <h3 class="ex-name" style="color:#fff; font-weight:800; letter-spacing:3px; text-transform:uppercase; font-size:20px;">House of Fade</h3>
          <p class="ex-sub" style="color:rgba(255,255,255,0.6);">Réservation par créneau, galerie coupes et ambiance premium à Lyon.</p>
          <div class="ex-chips ex-chips--dark"><span>Booking</span><span>Galerie</span><span>Tarifs</span></div>
          <span class="ex-btn" style="background:#c9a96e;color:#1a1a1a;">Voir l'exemple →</span>
        </div>
      </a>

      <!-- 3. CAFÉ — Carte claire, ambiance douce, pas de gradient sombre -->
      <a href="/site-web-cafe-paris/" class="ex-card ex-card--light" style="background:#f9f5f0;">
        <div class="ex-card__light-photo">
          <img src="/secteurs/cafe4.jpg" alt="Site café" loading="lazy" />
        </div>
        <div class="ex-card__light-body">
          <span class="ex-tag" style="background:#d4a574;color:#2c1810;">Café</span>
          <h3 class="ex-name" style="color:#2c1810; font-style:italic; font-weight:400; font-size:24px;">Café Analog</h3>
          <p class="ex-sub" style="color:#6b5b4d;">Torréfaction artisanale, carte interactive et lien commande à emporter.</p>
          <div class="ex-chips ex-chips--warm"><span>Menu</span><span>Horaires</span><span>Instagram</span></div>
          <span class="ex-btn" style="background:#2c1810;color:#f9f5f0;">Voir l'exemple →</span>
        </div>
      </a>

      <!-- 4. AVOCAT — Carte minimale corporate, bordure accent, pas de photo full -->
      <a href="/site-web-avocat-toulouse/" class="ex-card ex-card--minimal" style="background:#fff; border-left:4px solid #2a4a6b;">
        <div class="ex-card__minimal-content">
          <span class="ex-tag" style="background:#e8eef5;color:#2a4a6b;">Avocat</span>
          <h3 class="ex-name" style="color:#1a2a3a; font-family:var(--font-display),Georgia,serif; font-size:22px;">Cabinet Mercier</h3>
          <p class="ex-quote">"Un site qui projette exactement l'image de sérieux que je voulais."</p>
          <p class="ex-sub" style="color:#5a6a7a;">Droit des affaires & contentieux. Prise de RDV en ligne, articles SEO et pages par spécialité.</p>
          <div class="ex-chips ex-chips--corp"><span>Expertises</span><span>RDV en ligne</span><span>Blog juridique</span></div>
          <span class="ex-btn" style="background:#2a4a6b;color:#fff;">Voir l'exemple →</span>
        </div>
        <div class="ex-card__minimal-photo">
          <img src="/secteurs/lawyer2.jpg" alt="Cabinet avocat" loading="lazy" />
        </div>
      </a>

      <!-- 5. PILATES — Carte sombre full, accent néon, énergie -->
      <a href="/site-web-pilates-marseille/" class="ex-card ex-card--dark">
        <img src="/secteurs/pilate2.jpg" alt="Site pilates" loading="lazy" class="ex-card__bg" />
        <div class="ex-card__overlay" style="background:linear-gradient(135deg, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.5) 60%, rgba(10,10,10,0.3) 100%);"></div>
        <div class="ex-card__inner ex-card__inner--center">
          <span class="ex-tag" style="background:#c8ff00;color:#0a0a0a;">Pilates & Yoga</span>
          <h3 class="ex-name" style="color:#fff; font-weight:800; letter-spacing:4px; text-transform:uppercase; font-size:28px;">Studio Flow</h3>
          <p class="ex-sub" style="color:rgba(255,255,255,0.5);">Planning interactif, réservation par cours et paiement Stripe intégré à Marseille.</p>
          <div class="ex-chips ex-chips--neon"><span>Planning</span><span>Packs</span><span>Stripe</span></div>
          <span class="ex-btn" style="background:#c8ff00;color:#0a0a0a; font-weight:700;">Voir l'exemple →</span>
        </div>
      </a>

      <!-- 6. CTA -->
      <div class="ex-card ex-card--cta">
        <div class="ex-cta-inner">
          <span class="ex-cta-arrow">→</span>
          <h3>Votre métier.<br/>Votre site.<br/><em>48h.</em></h3>
          <p>Artisan, médecin, photographe, immobilier, consultant...</p>
          <a href="#commander" class="ex-btn" style="background:var(--accent);color:#fff;">Démarrer →</a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .section-header { text-align: center; }
  .section-tag {
    display: inline-block; font-size: 12px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
    background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
  }
  .section-h2 { font-size: clamp(32px, 4vw, 48px); color: var(--text-primary); margin-bottom: 16px; line-height: 1.1; }
  .section-h2 em { font-style: italic; color: var(--accent); }
  .section-sub { font-size: 16px; color: var(--text-secondary); max-width: 520px; margin: 0 auto; line-height: 1.6; }

  /* ── Mosaic grid — chaque carte a sa place ── */
  .ex-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  /* Card 1 (restaurant) : span 2 colonnes */
  .ex-card--hero { grid-column: span 2; }
  /* Card 2 (barbier) : span 2 colonnes */
  .ex-card--horizontal { grid-column: span 2; }
  /* Card 4 (avocat) : span 2 colonnes */
  .ex-card--minimal { grid-column: span 2; }

  /* ── Card base ── */
  .ex-card {
    border-radius: 16px; overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s;
    text-decoration: none; color: inherit; cursor: pointer;
  }
  .ex-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  }

  /* ── Shared elements ── */
  .ex-tag {
    display: inline-block; font-size: 10px; font-weight: 700; padding: 4px 12px;
    border-radius: 100px; text-transform: uppercase; letter-spacing: 0.06em;
    width: fit-content;
  }
  .ex-name { margin: 0; line-height: 1.15; }
  .ex-sub { font-size: 13px; line-height: 1.6; margin: 0; }
  .ex-quote {
    font-size: 14px; font-style: italic; color: #3a4a5a;
    line-height: 1.5; margin: 0;
    padding-left: 12px; border-left: 2px solid #2a4a6b;
  }
  .ex-btn {
    display: inline-block; font-size: 12px; font-weight: 600;
    padding: 10px 20px; border-radius: 8px;
    text-decoration: none; transition: all 0.2s; width: fit-content;
  }
  .ex-btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
  .ex-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .ex-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .ex-chips span {
    font-size: 9px; font-weight: 500; padding: 3px 9px; border-radius: 4px;
  }
  .ex-chips:not(.ex-chips--dark):not(.ex-chips--neon):not(.ex-chips--warm):not(.ex-chips--corp) span {
    background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7); backdrop-filter: blur(4px);
  }
  .ex-chips--dark span { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.5); }
  .ex-chips--neon span { background: rgba(200,255,0,0.1); color: #c8ff00; border: 1px solid rgba(200,255,0,0.2); }
  .ex-chips--warm span { background: rgba(212,165,116,0.15); color: #8b6b4a; }
  .ex-chips--corp span { background: #e8eef5; color: #2a4a6b; }

  /* ═══════════════════════════════════════════════════
     1. HERO — Grande carte immersive (restaurant)
     ═══════════════════════════════════════════════════ */
  .ex-card--hero {
    position: relative; min-height: 380px; display: flex;
  }
  .ex-card__bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  .ex-card--hero:hover .ex-card__bg,
  .ex-card--dark:hover .ex-card__bg { transform: scale(1.05); }
  .ex-card__overlay { position: absolute; inset: 0; z-index: 1; }
  .ex-card__inner {
    position: relative; z-index: 2; padding: 28px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .ex-card__inner--bottom { justify-content: flex-end; flex: 1; }
  .ex-card__inner--bottom .ex-name { color: #fff; }
  .ex-card__inner--bottom .ex-sub { color: rgba(255,255,255,0.65); max-width: 420px; }

  /* ═══════════════════════════════════════════════════
     2. HORIZONTAL — Photo à gauche, texte à droite (barbier)
     ═══════════════════════════════════════════════════ */
  .ex-card--horizontal {
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 280px;
  }
  .ex-card__photo-side {
    overflow: hidden; position: relative;
  }
  .ex-card__photo-side img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  .ex-card--horizontal:hover .ex-card__photo-side img { transform: scale(1.05); }
  .ex-card__text-side {
    padding: 28px; display: flex; flex-direction: column;
    gap: 12px; justify-content: center;
  }

  /* ═══════════════════════════════════════════════════
     3. LIGHT — Carte claire, photo arrondie (café)
     ═══════════════════════════════════════════════════ */
  .ex-card--light {
    display: flex; flex-direction: column; padding: 20px;
    gap: 16px;
  }
  .ex-card__light-photo {
    border-radius: 12px; overflow: hidden; height: 180px;
  }
  .ex-card__light-photo img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s;
  }
  .ex-card--light:hover .ex-card__light-photo img { transform: scale(1.05); }
  .ex-card__light-body {
    display: flex; flex-direction: column; gap: 8px;
  }

  /* ═══════════════════════════════════════════════════
     4. MINIMAL — Corporate, bordure accent (avocat)
     ═══════════════════════════════════════════════════ */
  .ex-card--minimal {
    display: grid; grid-template-columns: 1fr 200px;
    min-height: 260px; background: #fff;
  }
  .ex-card__minimal-content {
    padding: 28px; display: flex; flex-direction: column;
    gap: 10px; justify-content: center;
  }
  .ex-card__minimal-photo {
    overflow: hidden;
  }
  .ex-card__minimal-photo img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s;
  }
  .ex-card--minimal:hover .ex-card__minimal-photo img { transform: scale(1.05); }

  /* ═══════════════════════════════════════════════════
     5. DARK — Plein écran sombre, accent néon (pilates)
     ═══════════════════════════════════════════════════ */
  .ex-card--dark {
    position: relative; min-height: 320px; display: flex;
  }
  .ex-card__inner--center {
    justify-content: center; align-items: center; text-align: center;
    flex: 1;
  }
  .ex-card__inner--center .ex-sub { max-width: 360px; }

  /* ═══════════════════════════════════════════════════
     6. CTA
     ═══════════════════════════════════════════════════ */
  .ex-card--cta {
    border: 2px dashed var(--accent); background: var(--bg-peach);
    display: flex; align-items: center; justify-content: center;
    min-height: 280px;
  }
  .ex-cta-inner {
    padding: 36px 24px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .ex-cta-arrow {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--accent); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; font-weight: 700;
  }
  .ex-cta-inner h3 {
    font-size: 22px; font-weight: 700; color: var(--text-primary);
    line-height: 1.15; margin: 0;
  }
  .ex-cta-inner h3 em { color: var(--accent); }
  .ex-cta-inner p {
    font-size: 13px; color: var(--text-secondary); max-width: 220px;
    line-height: 1.5; margin: 0;
  }

  /* ═══════════════════════════════════════════════════
     Responsive
     ═══════════════════════════════════════════════════ */
  @media (max-width: 960px) {
    .ex-mosaic { grid-template-columns: 1fr 1fr; }
    .ex-card--hero, .ex-card--horizontal, .ex-card--minimal { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .ex-mosaic { grid-template-columns: 1fr; }
    .ex-card--hero, .ex-card--horizontal, .ex-card--minimal { grid-column: span 1; }
    .ex-card--horizontal { grid-template-columns: 1fr; }
    .ex-card__photo-side { height: 200px; }
    .ex-card--minimal { grid-template-columns: 1fr; }
    .ex-card__minimal-photo { height: 160px; }
    .ex-card--hero { min-height: 320px; }
  }
</style>

<script>
  document.querySelectorAll('.ex-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const nom = card.querySelector('.ex-name')?.textContent?.toLowerCase().trim() || '';
      window.datafast?.('example_click', { example: nom });
    });
  });
</script>
