---
const examples = [
  {
    category: "Coach / Consultant",
    image: "/secteurs/coach1.jpg",
    desc: "Landing claire, CTA visibles, structure pensée pour générer des demandes.",
    slug: "coach-sportif-bordeaux",
  },
  {
    category: "SaaS / Produit",
    image: "/secteurs/freelance3.jpg",
    desc: "Page rapide à comprendre, crédible, moderne, orientée essai ou démo.",
    slug: "cabinet-avocat-marseille",
  },
  {
    category: "Freelance / Personal brand",
    image: "/secteurs/restaurant3.jpg",
    desc: "Positionnement clair, offre visible immédiatement, design propre et rassurant.",
    slug: "restaurant-paris",
  },
];
---

<section class="exemples section-pad" id="exemples">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Exemples</div>
      <h2 class="section-h2">Des sites pensés<br/><em>pour convertir</em></h2>
      <p class="section-sub">Voici le type de sites que nous réalisons pour lancer rapidement une offre de manière propre et efficace.</p>
    </div>

    <div class="exemples-grid">
      {examples.map(ex => (
        <a href={`/exemples/${ex.slug}/`} class="ex-card">
          <div class="ex-visual">
            <div class="ex-mockup">
              <div class="ex-bar">
                <span class="ex-dot"></span>
                <span class="ex-dot"></span>
                <span class="ex-dot"></span>
              </div>
              <div class="ex-screen">
                <img src={ex.image} alt={`Exemple de site ${ex.category}`} loading="lazy" width="400" height="250" />
              </div>
            </div>
          </div>
          <div class="ex-content">
            <span class="ex-category">{ex.category}</span>
            <p class="ex-desc">{ex.desc}</p>
            <span class="ex-link">Voir ce style →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="exemples-more">
      <a href="/exemples/" class="more-link">Voir tous les exemples →</a>
    </div>
  </div>
</section>

<style>
.section-header { text-align: center; }
.section-tag {
  display: inline-block; font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
  background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
}
.section-h2 { font-size: clamp(28px, 4vw, 44px); color: var(--text-primary); margin-bottom: 16px; line-height: 1.1; }
.section-h2 em { font-style: italic; color: var(--accent); }
.section-sub { font-size: 15px; color: var(--text-secondary); max-width: 480px; margin: 0 auto; line-height: 1.7; }

.exemples-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.ex-card {
  display: block;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(.16,1,.3,1);
}
.ex-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(26,26,46,0.1);
  border-color: var(--border-strong);
}

.ex-visual { overflow: hidden; }

.ex-mockup {
  background: var(--black);
  border-radius: 0;
}
.ex-bar {
  display: flex;
  gap: 5px;
  padding: 8px 12px;
  background: #232340;
}
.ex-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
}
.ex-dot:first-child { background: #ff5f57; }
.ex-dot:nth-child(2) { background: #ffbd2e; }
.ex-dot:nth-child(3) { background: #28c840; }

.ex-screen {
  aspect-ratio: 16/10;
  overflow: hidden;
}
.ex-screen img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}
.ex-card:hover .ex-screen img {
  transform: scale(1.03);
}

.ex-content {
  padding: 24px;
}

.ex-category {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  background: var(--accent-pale);
  padding: 3px 10px;
  border-radius: 100px;
  margin-bottom: 10px;
}

.ex-desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 14px;
}

.ex-link {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--accent);
  transition: color 0.2s;
}
.ex-card:hover .ex-link { color: var(--accent-dark); }

.exemples-more {
  text-align: center;
  margin-top: 32px;
}
.more-link {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.2s;
}
.more-link:hover { color: var(--accent-dark); }

@media (max-width: 900px) {
  .exemples-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .exemples-grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
}
</style>
