---
const exemples = [
  {
    secteur: "Restaurant",
    url: "trattoria-bella.fr",
    nom: "Trattoria Bella",
    headline: "La dolce vita dans votre assiette",
    badge: "Ouvert ce soir · Bordeaux",
    cta: "Réserver une table",
    chips: ["Réservation en ligne", "Menu digital", "Google Maps"],
    photo: "/secteurs/restaurant3.jpg",
    accent: "#e8c97a",
    overlay: "linear-gradient(160deg, rgba(42,21,5,0.92) 0%, rgba(42,21,5,0.6) 50%, rgba(42,21,5,0.3) 100%)",
    desc: "Menu interactif, réservation Calendly et galerie photo — le tout livré en 48h.",
    style: "elegant",
  },
  {
    secteur: "Salon de beauté",
    url: "studio-caprice.fr",
    nom: "Studio Caprice",
    headline: "Révélez votre beauté",
    badge: "Lyon 6e · Sur rendez-vous",
    cta: "Prendre rendez-vous",
    chips: ["Calendly", "Galerie avant-après", "Tarifs"],
    photo: "/secteurs/beautysalon1.jpg",
    accent: "#e8a0d4",
    overlay: "linear-gradient(160deg, rgba(45,31,61,0.9) 0%, rgba(107,63,160,0.5) 60%, rgba(107,63,160,0.2) 100%)",
    desc: "Réservation en ligne, galerie avant/après et grille tarifaire élégante.",
    style: "luxe",
  },
  {
    secteur: "Thérapeute",
    url: "cabinet-serenite.fr",
    nom: "Cabinet Sérénité",
    headline: "Retrouvez votre équilibre intérieur",
    badge: "Nantes · Présentiel & visio",
    cta: "Voir les disponibilités",
    chips: ["Agenda en ligne", "Visio", "Blog bien-être"],
    photo: "/secteurs/thérapeutes2.jpg",
    accent: "#f4a261",
    overlay: "linear-gradient(160deg, rgba(13,59,102,0.9) 0%, rgba(30,111,168,0.5) 60%, rgba(30,111,168,0.15) 100%)",
    desc: "Agenda en ligne, consultations visio et articles SEO pour thérapeutes.",
    style: "zen",
  },
  {
    secteur: "Artisan",
    url: "plomberie-martin.fr",
    nom: "Plomberie Martin",
    headline: "Plombier certifié — Strasbourg",
    badge: "⚡ Urgence 7j/7",
    badgeUrgent: true,
    cta: "Demander un devis",
    chips: ["Devis en ligne", "Google My Business", "Avis clients"],
    photo: "/secteurs/contracting1.jpg",
    accent: "#f0a500",
    overlay: "linear-gradient(160deg, rgba(28,53,87,0.92) 0%, rgba(46,92,138,0.5) 60%, rgba(46,92,138,0.2) 100%)",
    desc: "Devis en ligne, fiche Google et avis clients — tout pour inspirer confiance.",
    style: "robust",
  },
  {
    secteur: "Coach sportif",
    url: "coach-clara.fr",
    nom: "COACH CLARA",
    headline: "Transformez votre corps.",
    badge: "Paris · En ligne & présentiel",
    cta: "Séance découverte gratuite",
    chips: ["Réservation", "Programmes", "Paiement Stripe"],
    photo: "/secteurs/coach2.jpg",
    accent: "#c8ff00",
    overlay: "linear-gradient(160deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0.2) 100%)",
    desc: "Réservation, programmes sur mesure et paiement intégré pour coachs.",
    style: "bold",
  },
];
---

<section class="exemples section-pad" id="exemples">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Exemples</div>
      <h2 class="section-h2">Des sites livrés en 48h,<br/><em>pour des pros comme vous</em></h2>
      <p class="section-sub">Chaque site est créé sur mesure selon votre secteur. Voici ce qu'on fait.</p>
    </div>

    <div class="exemples-grid">
      {exemples.map(e => (
        <div class={`exemple-card exemple-card--${e.style}`}>
          {/* Photo background */}
          <div class="exemple-photo">
            <img src={e.photo} alt={`Site ${e.secteur}`} loading="lazy" />
            <div class="exemple-overlay" style={`background:${e.overlay};`}></div>

            {/* Content over photo */}
            <div class="exemple-photo-content">
              <div class="exemple-top-row">
                <span class="exemple-secteur-pill" style={`background:${e.accent}; color:#000;`}>{e.secteur}</span>
                <span class={`exemple-badge ${e.badgeUrgent ? 'exemple-badge--urgent' : ''}`}>{e.badge}</span>
              </div>

              <div class="exemple-hero-text">
                <div class="exemple-url" style={`border-color:${e.accent}40;`}>
                  <span class="url-dot" style={`background:${e.accent};`}></span>
                  {e.url}
                </div>
                <h3 class="exemple-nom" style={e.style === 'bold' ? 'text-transform:uppercase; letter-spacing:2px; font-weight:800;' : e.style === 'luxe' ? 'font-style:italic; font-weight:400; letter-spacing:1px;' : ''}>{e.nom}</h3>
                <p class="exemple-headline">{e.headline}</p>
                <div class="exemple-cta-btn" style={`background:${e.accent}; color:${e.style === 'bold' ? '#000' : e.style === 'elegant' ? '#2a1505' : '#fff'};`}>
                  {e.cta}
                </div>
              </div>

              <div class="exemple-chips">
                {e.chips.map(chip => (
                  <span class="exemple-chip">{chip}</span>
                ))}
              </div>
            </div>
          </div>

          {/* Bottom info */}
          <div class="exemple-bottom">
            <div class="exemple-bottom-left">
              <span class="exemple-livraison">✓ Livré en 48h</span>
              <p class="exemple-desc">{e.desc}</p>
            </div>
            <a href="#commander" class="btn-exemple" style={`border-color:${e.accent}; color:${e.accent};`}>
              Commander ce site →
            </a>
          </div>
        </div>
      ))}

      {/* CTA card */}
      <div class="exemple-card exemple-card--cta">
        <div class="exemple-cta-inner">
          <div class="cta-sparkle">✨</div>
          <h3 class="cta-title">Et votre site<br/>dans 48h ?</h3>
          <p class="cta-sub">Avocat, médecin, photographe, boutique, consultant... quel que soit votre métier.</p>
          <a href="#commander" class="btn-cta-main">Créer mon site →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header { text-align: center; }
  .section-tag {
    display: inline-block; font-size: 12px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
    background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
  }
  .section-h2 {
    font-size: clamp(32px, 4vw, 48px); color: var(--text-primary);
    margin-bottom: 16px; line-height: 1.1;
  }
  .section-h2 em { font-style: italic; color: var(--accent); }
  .section-sub {
    font-size: 16px; color: var(--text-secondary);
    max-width: 480px; margin: 0 auto;
  }

  /* Grid */
  .exemples-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px; margin-top: 48px;
  }

  /* Card */
  .exemple-card {
    border-radius: 16px; overflow: hidden;
    border: 1px solid var(--border);
    background: var(--white);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .exemple-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  }

  /* Photo area */
  .exemple-photo {
    position: relative; height: 280px; overflow: hidden;
  }
  .exemple-photo img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.4s;
  }
  .exemple-card:hover .exemple-photo img {
    transform: scale(1.05);
  }
  .exemple-overlay {
    position: absolute; inset: 0; z-index: 1;
  }
  .exemple-photo-content {
    position: absolute; inset: 0; z-index: 2;
    display: flex; flex-direction: column;
    justify-content: space-between; padding: 14px 16px;
  }

  /* Top row */
  .exemple-top-row {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
  }
  .exemple-secteur-pill {
    font-size: 10px; font-weight: 700; padding: 4px 10px;
    border-radius: 100px; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .exemple-badge {
    font-size: 9px; padding: 3px 8px; border-radius: 100px;
    background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.8);
    backdrop-filter: blur(4px);
  }
  .exemple-badge--urgent {
    background: rgba(240,165,0,0.9); color: #000; font-weight: 700;
  }

  /* Hero text */
  .exemple-hero-text {
    display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
  }
  .exemple-url {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 9px; color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.15); border-radius: 4px;
    padding: 2px 8px;
  }
  .url-dot { width: 5px; height: 5px; border-radius: 50%; }
  .exemple-nom {
    font-size: 20px; font-weight: 600; color: #fff;
    line-height: 1.15; margin: 0;
  }
  .exemple-headline {
    font-size: 12px; color: rgba(255,255,255,0.65);
    line-height: 1.4; margin: 0;
  }
  .exemple-cta-btn {
    display: inline-block; font-size: 10px; font-weight: 600;
    padding: 6px 14px; border-radius: 6px; margin-top: 2px;
  }

  /* Chips */
  .exemple-chips {
    display: flex; gap: 4px; flex-wrap: wrap;
  }
  .exemple-chip {
    font-size: 8px; padding: 2px 7px; border-radius: 4px;
    background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.7);
    backdrop-filter: blur(4px);
  }

  /* Bottom */
  .exemple-bottom {
    padding: 14px 16px; display: flex;
    align-items: center; justify-content: space-between; gap: 12px;
  }
  .exemple-bottom-left { flex: 1; }
  .exemple-livraison {
    font-size: 11px; font-weight: 600; color: #22c55e; margin-bottom: 4px;
  }
  .exemple-desc {
    font-size: 12px; color: var(--text-secondary); line-height: 1.45; margin: 0;
  }

  .btn-exemple {
    display: inline-block; font-size: 11px; font-weight: 600;
    padding: 8px 14px; border: 1.5px solid; border-radius: 8px;
    text-decoration: none; transition: all 0.15s; white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-exemple:hover { filter: brightness(1.2); transform: translateY(-1px); }

  /* CTA card */
  .exemple-card--cta {
    border: 2px dashed var(--accent); background: var(--accent-pale);
    display: flex; align-items: center; justify-content: center;
  }
  .exemple-cta-inner {
    padding: 40px 28px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
  }
  .cta-sparkle { font-size: 36px; }
  .cta-title {
    font-size: 22px; font-weight: 700; color: var(--text-primary);
    line-height: 1.2; margin: 0;
  }
  .cta-sub {
    font-size: 13px; color: var(--text-secondary); max-width: 220px;
    line-height: 1.5; margin: 0;
  }
  .btn-cta-main {
    display: inline-block; background: var(--accent); color: var(--white);
    font-size: 14px; font-weight: 600; padding: 12px 24px;
    border-radius: 8px; text-decoration: none; transition: all 0.15s;
  }
  .btn-cta-main:hover { background: var(--accent-light); transform: translateY(-2px); }

  /* Responsive */
  @media (max-width: 900px) {
    .exemples-grid { grid-template-columns: repeat(2, 1fr); }
    .exemple-photo { height: 240px; }
  }
  @media (max-width: 580px) {
    .exemples-grid { grid-template-columns: 1fr; }
    .exemple-photo { height: 260px; }
    .exemple-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  document.querySelectorAll('.exemple-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const nom = card.querySelector('.exemple-nom')?.textContent?.toLowerCase().trim() || '';
      window.datafast?.('example_click', { example: nom });
    });
  });
</script>
