---
const exemples = [
  {
    secteur: "Restaurant",
    url: "trattoria-bella.fr",
    nom: "Trattoria Bella",
    nomStyle: "",
    headline: "La dolce vita<br/>dans votre assiette",
    badge: "Ouvert ce soir · Bordeaux",
    badgeUrgent: false,
    cta: "Réserver une table",
    chips: ["RDV en ligne", "Menu digital", "Google Maps"],
    heroBg: "#2a1505",
    heroGradient: "",
    accent: "#e8c97a",
    navBg: "rgba(42,21,5,0.95)",
    desc: "Menu en ligne, réservation et galerie photo pour un restaurant italien.",
  },
  {
    secteur: "Coiffure",
    url: "studio-caprice.fr",
    nom: "Studio Caprice",
    nomStyle: "font-style:italic;",
    headline: "Révélez<br/>votre beauté",
    badge: "Lyon 6e · Sur rendez-vous",
    badgeUrgent: false,
    cta: "Prendre RDV",
    chips: ["Calendly", "Galerie avant-après", "Tarifs"],
    heroBg: "",
    heroGradient: "linear-gradient(135deg, #2d1f3d, #6b3fa0)",
    accent: "#e8a0d4",
    navBg: "rgba(45,31,61,0.95)",
    desc: "Prise de rendez-vous, galerie avant/après et grille tarifaire.",
  },
  {
    secteur: "Thérapeute",
    url: "cabinet-serenite.fr",
    nom: "Cabinet Sérénité",
    nomStyle: "",
    headline: "Retrouvez votre<br/>équilibre intérieur",
    badge: "Nantes · Présentiel & visio",
    badgeUrgent: false,
    cta: "Voir mes disponibilités",
    chips: ["Agenda en ligne", "Visio", "Blog SEO"],
    heroBg: "",
    heroGradient: "linear-gradient(135deg, #0d3b66, #1e6fa8)",
    accent: "#f4a261",
    navBg: "rgba(13,59,102,0.95)",
    desc: "Agenda en ligne, visio intégrée et articles SEO pour thérapeutes.",
  },
  {
    secteur: "Artisan",
    url: "plomberie-martin.fr",
    nom: "Plomberie Martin",
    nomStyle: "",
    headline: "Plombier certifié<br/>Strasbourg",
    badge: "⚡ Urgence 7j/7",
    badgeUrgent: true,
    cta: "Demander un devis",
    chips: ["Devis en ligne", "Google My Business", "Avis clients"],
    heroBg: "",
    heroGradient: "linear-gradient(135deg, #1c3557, #2e5c8a)",
    accent: "#f0a500",
    navBg: "rgba(28,53,87,0.95)",
    desc: "Devis en ligne, fiche Google et avis clients pour artisans.",
  },
  {
    secteur: "Coach sport",
    url: "coach-clara.fr",
    nom: "COACH CLARA",
    nomStyle: "text-transform:uppercase;font-weight:700;letter-spacing:1px;",
    headline: "Transformez<br/>votre corps.",
    badge: "Paris · En ligne & présentiel",
    badgeUrgent: false,
    cta: "Séance découverte gratuite",
    chips: ["Réservation", "Programmes", "Paiement Stripe"],
    heroBg: "#0a0a0a",
    heroGradient: "",
    accent: "#c8ff00",
    navBg: "rgba(10,10,10,0.95)",
    heroSpecial: true,
    desc: "Réservation, programmes et paiement intégré pour coachs sportifs.",
  },
];
---

<section class="exemples section-pad" id="exemples">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Exemples</div>
      <h2 class="section-h2">Des sites livrés en 48h,<br/><em>pour des pros comme vous</em></h2>
      <p class="section-sub">Chaque site est créé sur mesure — pas de template générique.</p>
    </div>

    <div class="exemples-grid">
      {exemples.map(e => (
        <div class="exemple-card">
          <div class="exemple-badge-top" style={`background:${e.accent}20; color:${e.accent}; border:1px solid ${e.accent}40;`}>
            {e.secteur}
          </div>
          <div class="browser-chrome">
            <div class="browser-bar">
              <div class="browser-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <div class="browser-url">{e.url}</div>
            </div>
            <div class="browser-content">
              {/* Mini site preview */}
              <div style={`font-family:-apple-system,system-ui,sans-serif;overflow:hidden;`}>
                {/* Nav */}
                <div style={`background:${e.navBg}; padding:6px 10px; display:flex; align-items:center; justify-content:space-between;`}>
                  <span style={`color:#fff; font-size:8px; font-weight:600; ${e.nomStyle}`}>{e.nom}</span>
                  <div style="display:flex; gap:6px; align-items:center;">
                    <span style="color:rgba(255,255,255,0.5); font-size:6px;">Menu</span>
                    <span style="color:rgba(255,255,255,0.5); font-size:6px;">Contact</span>
                    <span style={`background:${e.accent}; color:${e.heroBg || '#111'}; font-size:5px; padding:2px 5px; border-radius:3px; font-weight:600;`}>RDV</span>
                  </div>
                </div>
                {/* Hero */}
                <div style={`${e.heroGradient ? `background:${e.heroGradient}` : `background:${e.heroBg || '#111'}`}; padding:16px 10px 12px; ${e.heroSpecial ? `border-top:2px solid ${e.accent};` : ''} text-align:center; position:relative;`}>
                  {/* Badge */}
                  <div style={`display:inline-block; font-size:5px; padding:2px 6px; border-radius:10px; margin-bottom:6px; ${e.badgeUrgent ? `background:${e.accent}; color:#000; font-weight:700;` : `background:rgba(255,255,255,0.12); color:rgba(255,255,255,0.7);`}`}>
                    {e.badge}
                  </div>
                  {/* Headline */}
                  <div style={`color:#fff; font-size:11px; font-weight:700; line-height:1.25; margin-bottom:4px;`} set:html={e.headline} />
                  <div style="color:rgba(255,255,255,0.6); font-size:5.5px; margin-bottom:8px;">Un site professionnel livré en 48h</div>
                  {/* CTA Button */}
                  <div style={`display:inline-block; background:${e.accent}; color:${(e.heroBg === '#0a0a0a' || !e.heroBg) ? '#000' : '#fff'}; font-size:6px; font-weight:600; padding:4px 10px; border-radius:4px;`}>
                    {e.cta}
                  </div>
                  {/* Chips */}
                  <div style="display:flex; justify-content:center; gap:3px; margin-top:6px; flex-wrap:wrap;">
                    {e.chips.map(chip => (
                      <span style={`font-size:4.5px; padding:1.5px 4px; border-radius:3px; background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.6);`}>{chip}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="exemple-bottom">
            <div class="exemple-livraison">✓ Livré en 48h</div>
            <h3 class="exemple-titre">{e.nom}</h3>
            <p class="exemple-desc">{e.desc}</p>
            <a href="#commander" class="btn-exemple" style={`border-color:${e.accent}; color:${e.accent};`}>
              Je veux ce site →
            </a>
          </div>
        </div>
      ))}

      {/* CTA card */}
      <div class="exemple-card exemple-cta-card">
        <div class="browser-chrome">
          <div class="browser-bar">
            <div class="browser-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="browser-url">votre-site.fr</div>
          </div>
          <div class="browser-content">
            <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; padding:20px; text-align:center; background:#fafaf8;">
              <div style="font-size:28px; margin-bottom:8px;">✨</div>
              <div style="font-size:13px; font-weight:600; color:#1A3C34; line-height:1.3;">Votre site ici<br/>dans 48h</div>
              <div style="font-size:9px; color:#888; margin-top:4px; line-height:1.4;">Avocat, médecin, photographe,<br/>boutique...</div>
            </div>
          </div>
        </div>
        <div class="exemple-bottom" style="text-align:center;">
          <a href="#commander" class="btn-exemple btn-exemple-accent">Créer mon site →</a>
        </div>
      </div>
    </div>

    <div class="exemples-cta">
      <a href="#commander" class="btn-primary">Je veux un site comme ça →</a>
    </div>
  </div>
</section>

<style>
  .section-header { text-align: center; }
  .section-tag {
    display: inline-block; font-size: 12px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent);
    background: var(--accent-pale); padding: 5px 14px; border-radius: 100px; margin-bottom: 16px;
  }
  .section-h2 {
    font-size: clamp(32px, 4vw, 48px); color: var(--text-primary);
    margin-bottom: 16px; line-height: 1.1;
  }
  .section-h2 em { font-style: italic; color: var(--accent); }
  .section-sub {
    font-size: 16px; color: var(--text-secondary);
    max-width: 480px; margin: 0 auto;
  }

  .exemples-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px; margin-top: 48px;
  }

  .exemple-card {
    border: 1px solid var(--border); border-radius: var(--radius-lg);
    overflow: hidden; transition: transform 0.2s, box-shadow 0.2s;
    background: var(--white); position: relative;
  }
  .exemple-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(14,14,14,0.1);
  }

  .exemple-cta-card {
    border-style: dashed; border-color: var(--accent);
  }

  .exemple-badge-top {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    font-size: 10px; font-weight: 600; padding: 3px 10px;
    border-radius: 100px; backdrop-filter: blur(4px);
  }

  /* Browser chrome */
  .browser-chrome {
    border-bottom: 1px solid var(--border);
  }
  .browser-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 10px; background: #f5f5f4;
    border-bottom: 1px solid #e5e5e4;
  }
  .browser-dots { display: flex; gap: 4px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }
  .browser-url {
    flex: 1; font-size: 9px; color: #888;
    background: #fff; border: 1px solid #e5e5e4;
    border-radius: 4px; padding: 2px 8px; text-align: center;
  }
  .browser-content {
    min-height: 130px; overflow: hidden;
  }

  /* Bottom info */
  .exemple-bottom { padding: 14px 16px 16px; }
  .exemple-livraison {
    font-size: 11px; font-weight: 500; color: #22c55e; margin-bottom: 6px;
  }
  .exemple-titre {
    font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px;
  }
  .exemple-desc {
    font-size: 12px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 12px;
  }

  .btn-exemple {
    display: inline-block; font-size: 12px; font-weight: 500;
    padding: 6px 14px; border: 1.5px solid var(--accent);
    border-radius: var(--radius-sm); color: var(--accent);
    text-decoration: none; transition: all 0.15s;
  }
  .btn-exemple:hover {
    background: var(--accent); color: var(--white);
  }
  .btn-exemple-accent {
    border-color: var(--accent); color: var(--accent);
    font-size: 13px; font-weight: 600; padding: 10px 20px;
    margin-top: 8px;
  }

  .exemples-cta { text-align: center; margin-top: 40px; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 15px; font-weight: 500; background: var(--accent);
    color: var(--white); padding: 14px 28px; border-radius: var(--radius-md);
    transition: background 0.15s, transform 0.1s; text-decoration: none;
  }
  .btn-primary:hover { background: var(--accent-light); transform: translateY(-2px); }

  @media (max-width: 900px) {
    .exemples-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .exemples-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll('.exemple-card').forEach(card => {
    card.addEventListener('click', () => {
      const titre = card.querySelector('.exemple-titre')?.textContent?.toLowerCase().trim() || '';
      window.datafast?.('example_click', { example: titre });
    });
  });
</script>
